# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit ไฟล์ .env)

# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# ใช้ service_role key (หรือ secret key) เพราะตารางเปิด RLS ไว้และไม่มี policy
# ห้ามใส่ key นี้ในแอป Flutter เด็ดขาด
SUPABASE_KEY=

# ใช้เซ็น JWT สร้างได้ด้วย: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# (ไม่บังคับ) โดเมนที่อนุญาตให้เรียก API จากเบราว์เซอร์ คั่นด้วยจุลภาค
# CORS_ORIGINS=http://localhost:3000
