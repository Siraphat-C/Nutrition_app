      },
      "html": "<style>\n  @import url(\"https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;500;600;700&display=swap\");\n  @import url(\"https://cdn.jsdelivr.net/npm/remixicon@4.9.1/fonts/remixicon.css\");\n\n  html, body { height: 100%; margin: 0; }\n  body {\n    font-family: \"IBM Plex Sans Thai\", \"Noto Sans Thai\", sans-serif;\n    background: #ffffff;\n    color: #1E293B;\n    -webkit-font-smoothing: antialiased;\n  }\n  .fieldbox input { font-family: inherit; }\n  .fieldbox input:focus { outline: none; }\n  i { line-height: 1; }\n</style>\n<div class=\"h-full min-h-[640px] flex flex-col bg-white\" data-kid=\"1\" data-name=\"account edit screen layout container\">\n<!-- status bar -->\n<div class=\"h-[44px] shrink-0 px-6 flex items-center justify-between\" data-kid=\"1-1\" data-name=\"phone status bar\">\n<span class=\"text-[13px] font-bold text-[#1E293B] tabular-nums tracking-tight\" data-kid=\"1-1-1\" data-name=\"status bar clock time\">9:41</span>\n<div class=\"flex items-center gap-[6px] text-[#1E293B]\" data-kid=\"1-1-2\" data-name=\"status bar signal icons\">\n<i class=\"ri-signal-tower-fill text-[14px]\" data-kid=\"1-1-2-1\" data-name=\"cellular signal tower icon\"></i>\n<i class=\"ri-wifi-fill text-[14px]\" data-kid=\"1-1-2-2\" data-name=\"wifi signal icon\"></i>\n<span class=\"relative inline-block w-[22px] h-[11px] rounded-[3px] border border-[#1E293B]/80\" data-kid=\"1-1-2-3\" data-name=\"battery indicator\">\n<span class=\"absolute left-[1px] top-[1px] bottom-[1px] w-[14px] rounded-[2px] bg-[#1E293B]\" data-kid=\"1-1-2-3-1\" data-name=\"battery charge fill indicator\"></span>\n<span class=\"absolute -right-[3px] top-[3px] h-[5px] w-[2px] rounded-r-[1px] bg-[#1E293B]/80\" data-kid=\"1-1-2-3-2\" data-name=\"battery terminal nub\"></span>\n</span>\n</div>\n</div>\n<!-- app bar -->\n<div class=\"h-[60px] shrink-0 px-6 flex items-center gap-3 border-b-[1.5px] border-[#F1F5F9]\" data-kid=\"1-2\" data-name=\"app bar with back button and title\">\n<button aria-label=\"ย้อนกลับ\" class=\"w-[40px] h-[40px] shrink-0 rounded-[14px] bg-white border-[1.5px] border-[#F1F5F9] flex items-center justify-center text-[#1E293B]\" data-kid=\"1-2-1\" data-name=\"back navigation button\" type=\"button\">\n<i class=\"ri-arrow-left-s-line text-[20px]\" data-kid=\"1-2-1-1\" data-name=\"left arrow back icon\"></i>\n</button>\n<h1 class=\"text-[18px] font-bold text-[#1E293B] leading-none\" data-kid=\"1-2-2\" data-name=\"app bar page title heading\">แก้ไขข้อมูลบัญชี</h1>\n</div>\n<!-- scrollable form -->\n<div class=\"flex-1 overflow-y-auto px-6\" data-kid=\"1-3\" data-name=\"scrollable form content area\">\n<!-- stored account identity -->\n<div class=\"pt-6\" data-kid=\"1-3-1\" data-name=\"stored account identity section\">\n<div class=\"min-h-[96px] rounded-[24px] bg-[#E8F8EF] p-4 flex items-center gap-4\" data-kid=\"1-3-1-1\" data-name=\"account identity summary card\">\n<div class=\"w-[56px] h-[56px] shrink-0 rounded-full bg-white border-[1.5px] border-[#20C96A]/30 flex items-center justify-center\" data-kid=\"1-3-1-1-1\" data-name=\"account avatar placeholder circle\">\n<i class=\"ri-account-circle-fill text-[26px] text-[#20C96A]\" data-kid=\"1-3-1-1-1-1\" data-name=\"account circle avatar icon\"></i>\n</div>\n<div class=\"min-w-0\" data-kid=\"1-3-1-1-2\" data-name=\"account identity text column\">\n<p class=\"text-[17px] font-bold text-[#1E293B] leading-[22px] truncate\" data-kid=\"1-3-1-1-2-1\" data-name=\"displayed account full name\">ปิติโชค โดราเอม่อน</p>\n<p class=\"mt-[3px] text-[13px] font-medium text-[#64748B] leading-[18px] truncate\" data-kid=\"1-3-1-1-2-2\" data-name=\"displayed account email\">user2@gmail.com</p>\n</div>\n</div>\n</div>\n<!-- editable fields -->\n<div class=\"mt-5 flex flex-col gap-[14px] pb-6\" data-kid=\"1-3-2\" data-name=\"editable form fields group\">\n<div data-kid=\"1-3-2-1\" data-name=\"full name field group\">\n<label class=\"block text-[13px] font-semibold text-[#64748B] leading-none mb-[8px]\" data-kid=\"1-3-2-1-1\" data-name=\"full name field label\" for=\"fullname\">ชื่อ - นามสกุล</label>\n<div class=\"fieldbox h-[54px] rounded-[16px] bg-white border-[1.5px] border-[#F1F5F9] flex items-center gap-[10px] px-[14px] focus-within:border-[#20C96A]\" data-kid=\"1-3-2-1-2\" data-name=\"full name input field box\">\n<i class=\"ri-user-line shrink-0 text-[18px] text-[#64748B]\" data-kid=\"1-3-2-1-2-1\" data-name=\"user profile field icon\"></i>\n<input autocomplete=\"name\" class=\"min-w-0 flex-1 h-full border-0 bg-transparent text-[14px] font-semibold text-[#1E293B]\" data-kid=\"1-3-2-1-2-2\" data-name=\"full name text input field\" id=\"fullname\" type=\"text\" value=\"ปิติโชค โดราเอม่อน\"/>\n</div>\n</div>\n<div data-kid=\"1-3-2-2\" data-name=\"email field group\">\n<label class=\"block text-[13px] font-semibold text-[#64748B] leading-none mb-[8px]\" data-kid=\"1-3-2-2-1\" data-name=\"email field label\" for=\"email\">อีเมล</label>\n<div class=\"fieldbox h-[54px] rounded-[16px] bg-white border-[1.5px] border-[#F1F5F9] flex items-center gap-[10px] px-[14px] focus-within:border-[#20C96A]\" data-kid=\"1-3-2-2-2\" data-name=\"email input field box\">\n<i class=\"ri-mail-line shrink-0 text-[18px] text-[#64748B]\" data-kid=\"1-3-2-2-2-1\" data-name=\"envelope email field icon\"></i>\n<input autocomplete=\"email\" class=\"min-w-0 flex-1 h-full border-0 bg-transparent text-[14px] font-semibold text-[#1E293B]\" data-kid=\"1-3-2-2-2-2\" data-name=\"email text input field\" id=\"email\" spellcheck=\"false\" type=\"email\" value=\"user2@gmail.com\"/>\n</div>\n</div>\n<div data-kid=\"1-3-2-3\" data-name=\"birth date field group\">\n<span class=\"block text-[13px] font-semibold text-[#64748B] leading-none mb-[8px]\" data-kid=\"1-3-2-3-1\" data-name=\"birth date field label\">วันเกิด</span>\n<button class=\"w-full h-[54px] rounded-[16px] bg-white border-[1.5px] border-[#F1F5F9] flex items-center gap-[10px] px-[14px] text-left\" data-kid=\"1-3-2-3-2\" data-name=\"birth date selector button\" type=\"button\">\n<i class=\"ri-calendar-event-line shrink-0 text-[18px] text-[#20C96A]\" data-kid=\"1-3-2-3-2-1\" data-name=\"calendar date field icon\"></i>\n<span class=\"flex-1 min-w-0 text-[14px] font-semibold text-[#1E293B] tabular-nums\" data-kid=\"1-3-2-3-2-2\" data-name=\"birth date display text\">14/3/2540</span>\n<i class=\"ri-arrow-right-s-line shrink-0 text-[18px] text-[#64748B]\" data-kid=\"1-3-2-3-2-3\" data-name=\"right arrow navigation icon\"></i>\n</button>\n<p class=\"mt-[8px] text-[13px] font-medium text-[#64748B] leading-[18px]\" data-kid=\"1-3-2-3-3\" data-name=\"Thai Buddhist calendar date format hint\">แสดงเป็นวันที่/เดือน/ปี พ.ศ.</p>\n</div>\n<p class=\"mt-[6px] text-[13px] font-medium text-[#64748B] leading-[18px]\" data-kid=\"1-3-2-4\" data-name=\"account creation date hint text\">บัญชีนี้สร้างเมื่อ 12 ม.ค. 2566</p>\n</div>\n</div>\n<!-- save / discard -->\n<div class=\"shrink-0 bg-white border-t-[1.5px] border-[#F1F5F9]\" data-kid=\"1-4\" data-name=\"footer action bar\">\n<div class=\"px-6 pt-3 pb-1\" data-kid=\"1-4-1\" data-name=\"footer action buttons column\">\n<button class=\"w-full h-[54px] rounded-[18px] bg-[#20C96A] text-white text-[15px] font-bold flex items-center justify-center gap-[8px] shadow-[0_8px_18px_rgba(32,201,106,0.28)] active:bg-[#0E9F55]\" data-kid=\"1-4-1-1\" data-name=\"primary save account button\" type=\"button\">\n<i class=\"ri-check-line text-[20px]\" data-kid=\"1-4-1-1-1\" data-name=\"checkmark save icon\"></i>\n        บันทึกข้อมูลบัญชี\n      </button>\n<button class=\"mt-3 w-full h-[44px] text-[13px] font-semibold text-[#64748B] text-center active:text-[#1E293B]\" data-kid=\"1-4-1-2\" data-name=\"discard changes text button\" type=\"button\">\n        ทิ้งการแก้ไข\n      </button>\n</div>\n<div class=\"h-[24px]\" data-kid=\"1-4-2\" data-name=\"footer bottom safe area spacer\"></div>\n</div>\n</div>",
      "comments": [],
      "created": "2026-11-19T10:44:01.487161+00:00",
      "modified": "2026-11-19T10:45:26.432957+00:00",
      "id": "var_f80bab8ed3f5",
      "contentHeight": 736
    },
    "var_18a81461ad2b": {
      "type": "variant",
      "label": "ตั้งรหัสผ่านใหม่",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 2375,
        "y": 0,
        "w": 375,
        "h": 0
      },
      "html": "<style>\n  @import url('https://cdn.jsdelivr.net/npm/remixicon@4.9.1/fonts/remixicon.css');\n\n  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }\n  html, body {\n    margin: 0;\n    padding: 0;\n    background: #FFFFFF;\n    color: #1E293B;\n    font-family: Roboto, \"Noto Sans Thai\", \"Leelawadee UI\", Tahoma, sans-serif;\n    font-size: 14px;\n    line-height: 1.3;\n    width: 375px;\n    min-height: 100%;\n  }\n  .page { height: 812px; display: flex; flex-direction: column; background: #FFFFFF; }\n\n  /* ── status bar ── */\n  .statusbar {\n    flex: none; height: 44px; padding: 0 20px 0 24px;\n    display: flex; align-items: center; justify-content: space-between;\n  }\n  .statusbar .time { font-size: 13px; font-weight: 700; color: #1E293B; letter-spacing: -0.2px; }\n  .statusbar .sysicons { display: flex; align-items: center; gap: 5px; color: #1E293B; }\n  .statusbar .sysicons i { font-size: 14px; }\n  .statusbar .batt {\n    width: 22px; height: 11px; border: 1.4px solid #1E293B; border-radius: 3px;\n    position: relative; display: inline-block;\n  }\n  .statusbar .batt::before { content: \"\"; position: absolute; inset: 1.5px; right: 6px; background: #1E293B; border-radius: 1px; }\n  .statusbar .batt::after { content: \"\"; position: absolute; right: -3px; top: 3px; width: 2px; height: 4px; background: #1E293B; border-radius: 0 1px 1px 0; }\n\n  /* ── app bar (CleanAppBar) ── */\n  .appbar {\n    flex: none; height: 60px; padding: 0 24px;\n    display: flex; align-items: center; gap: 14px;\n    background: #FFFFFF; border-bottom: 1px solid #F1F5F9;\n  }\n  .iconbtn {\n    flex: none; width: 40px; height: 40px; border-radius: 12px;\n    border: 1.5px solid #F1F5F9; background: #FFFFFF;\n    display: flex; align-items: center; justify-content: center;\n    box-shadow: 0 3px 10px rgba(30,41,59,.03); cursor: pointer;\n  }\n  .iconbtn i { font-size: 20px; color: #1E293B; }\n  .appbar h1 { margin: 0; font-size: 18px; font-weight: 800; color: #1E293B; letter-spacing: -0.3px; }\n\n  /* ── content ── */\n  .content {\n    flex: 1; padding: 24px;\n    display: flex; flex-direction: column;\n    justify-content: center;\n    gap: 10px;\n  }\n\n  .contextstrip {\n    flex: none; min-height: 72px; padding: 14px 16px;\n    background: #E8F8EF; border-radius: 18px;\n    display: flex; align-items: center; gap: 12px;\n  }\n  .contextstrip .glyph {\n    flex: none; width: 40px; height: 40px; border-radius: 12px; background: #FFFFFF;\n    border: 1.5px solid rgba(32,201,106,.30);\n    display: flex; align-items: center; justify-content: center;\n  }\n  .contextstrip .glyph i { font-size: 20px; color: #20C96A; }\n  .contextstrip .stack { display: flex; flex-direction: column; gap: 3px; min-width: 0; }\n  .contextstrip .k { font-size: 12px; font-weight: 700; color: #64748B; }\n  .contextstrip .v { font-size: 14px; font-weight: 700; color: #1E293B; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n\n  /* ── fields (CleanTextField) ── */\n  .fields { margin-top: 20px; }\n  .group { margin-bottom: 14px; }\n  .group:last-child { margin-bottom: 0; }\n  .group > label { display: block; font-size: 13px; font-weight: 700; color: #64748B; margin-bottom: 8px; }\n  .field {\n    height: 54px; display: flex; align-items: center;\n    background: #FFFFFF; border: 1.5px solid #F1F5F9; border-radius: 16px;\n    box-shadow: 0 3px 10px rgba(30,41,59,.03);\n    transition: border-color .12s ease, box-shadow .12s ease;\n  }\n  .field:focus-within { border-color: #20C96A; box-shadow: 0 3px 12px rgba(32,201,106,.10); }\n  .field .pre { flex: none; width: 44px; display: flex; align-items: center; justify-content: center; }\n  .field .pre i { font-size: 18px; color: #64748B; }\n  .field input {\n    flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; padding: 0;\n    font-family: inherit; font-size: 14px; font-weight: 500; color: #1E293B; letter-spacing: .5px;\n  }\n  .field input::placeholder { color: #64748B; font-weight: 400; letter-spacing: 0; }\n  .field .suf {\n    flex: none; width: 44px; height: 54px; display: flex; align-items: center; justify-content: center;\n    background: transparent; border: 0; cursor: pointer; padding: 0;\n  }\n  .field .suf i { font-size: 18px; color: #64748B; }\n\n  /* ── rule + match lines ── */\n  .notes { margin-top: 20px; display: flex; flex-direction: column; gap: 6px; }\n  .note { display: flex; align-items: center; gap: 6px; font-size: 12px; color: #64748B; }\n  .note i { font-size: 14px; color: #20C96A; flex: none; }\n\n  /* ── primary action (PrimaryButton) ── */\n  .primary {\n    margin-top: 20px; width: 100%; height: 54px; border: 0; border-radius: 18px;\n    background: #20C96A; color: #FFFFFF; cursor: pointer;\n    font-family: inherit; font-size: 15px; font-weight: 700; letter-spacing: -0.2px;\n    display: flex; align-items: center; justify-content: center; gap: 8px;\n    box-shadow: 0 6px 14px rgba(32,201,106,.28);\n    transition: transform .12s ease, box-shadow .12s ease;\n  }\n  .primary i { font-size: 20px; }\n  .primary:active { transform: scale(.985); box-shadow: 0 3px 8px rgba(32,201,106,.22); }\n\n  /* ── one-step-away text action ── */\n  .expired {\n    margin-top: 20px; padding: 0 8px; text-align: center;\n    font-size: 13px; font-weight: 700; color: #64748B; cursor: pointer;\n    border: 0; background: transparent; font-family: inherit;\n  }\n  .expired:active { color: #1E293B; }\n</style>\n<div class=\"page\" data-kid=\"1\" data-name=\"page layout container\">\n<div class=\"statusbar\" data-kid=\"1-1\" data-name=\"phone status bar\">\n<span class=\"time\" data-kid=\"1-1-1\" data-name=\"status bar clock time\">9:41</span>\n<span class=\"sysicons\" data-kid=\"1-1-2\" data-name=\"status bar system icons group\">\n<i class=\"ri-bar-chart-horizontal-fill\" data-kid=\"1-1-2-1\" data-name=\"cellular signal strength icon\"></i>\n<i class=\"ri-wifi-line\" data-kid=\"1-1-2-2\" data-name=\"wifi icon\"></i>\n<span class=\"batt\" data-kid=\"1-1-2-3\" data-name=\"battery level indicator\"></span>\n</span>\n</div>\n<header class=\"appbar\" data-kid=\"1-2\" data-name=\"app top bar with title\">\n<div class=\"iconbtn\" data-kid=\"1-2-1\" data-name=\"back navigation button\"><i class=\"ri-arrow-left-s-line\" data-kid=\"1-2-1-1\" data-name=\"left arrow back icon\"></i></div>\n<h1 data-kid=\"1-2-2\" data-name=\"page title heading\">ตั้งรหัสผ่านใหม่</h1>\n</header>\n<div class=\"content\" data-kid=\"1-3\" data-name=\"form content section\">\n<div class=\"contextstrip\" data-kid=\"1-3-1\" data-name=\"context strip showing account\">\n<span class=\"glyph\" data-kid=\"1-3-1-1\" data-name=\"context strip icon badge\"><i class=\"ri-key-2-line\" data-kid=\"1-3-1-1-1\" data-name=\"key glyph icon\"></i></span>\n<span class=\"stack\" data-kid=\"1-3-1-2\" data-name=\"context strip label/text stack\">\n<span class=\"k\" data-kid=\"1-3-1-2-1\" data-name=\"account label text\">บัญชี</span>\n<span class=\"v\" data-kid=\"1-3-1-2-2\" data-name=\"account email value text\">user2@gmail.com</span>\n</span>\n</div>\n<div class=\"fields\" data-kid=\"1-3-2\" data-name=\"form fields container\">\n<div class=\"group\" data-kid=\"1-3-2-1\" data-name=\"new password field group\">\n<label data-kid=\"1-3-2-1-1\" data-name=\"new password field label\" for=\"pw1\">รหัสผ่านใหม่</label>\n<div class=\"field\" data-kid=\"1-3-2-1-2\" data-name=\"new password input field row\">\n<span class=\"pre\" data-kid=\"1-3-2-1-2-1\" data-name=\"leading icon slot\"><i class=\"ri-lock-2-line\" data-kid=\"1-3-2-1-2-1-1\" data-name=\"lock icon\"></i></span>\n<input autocomplete=\"new-password\" data-kid=\"1-3-2-1-2-2\" data-name=\"new password input field\" id=\"pw1\" spellcheck=\"false\" type=\"password\" value=\"Nutri2540!\"/>\n<button aria-label=\"ซ่อนรหัสผ่าน\" class=\"suf\" data-kid=\"1-3-2-1-2-3\" data-name=\"hide/show password toggle button\" data-target=\"pw1\" type=\"button\"><i class=\"ri-eye-off-line\" data-dynamic=\"true\" data-kid=\"1-3-2-1-2-3-1\" data-name=\"eye icon indicating password hidden\" data-reason=\"icon class rewritten by toggle script on click\"></i></button>\n</div>\n</div>\n<div class=\"group\" data-kid=\"1-3-2-2\" data-name=\"confirm password field group\">\n<label data-kid=\"1-3-2-2-1\" data-name=\"confirm password field label\" for=\"pw2\">ยืนยันรหัสผ่านใหม่</label>\n<div class=\"field\" data-kid=\"1-3-2-2-2\" data-name=\"confirm password input field row\">\n<span class=\"pre\" data-kid=\"1-3-2-2-2-1\" data-name=\"leading icon slot\"><i class=\"ri-lock-2-line\" data-kid=\"1-3-2-2-2-1-1\" data-name=\"lock icon\"></i></span>\n<input autocomplete=\"new-password\" data-kid=\"1-3-2-2-2-2\" data-name=\"confirm password input field\" id=\"pw2\" spellcheck=\"false\" type=\"password\" value=\"Nutri2540!\"/>\n<button aria-label=\"ซ่อนรหัสผ่าน\" class=\"suf\" data-kid=\"1-3-2-2-2-3\" data-name=\"hide/show password toggle button\" data-target=\"pw2\" type=\"button\"><i class=\"ri-eye-off-line\" data-dynamic=\"true\" data-kid=\"1-3-2-2-2-3-1\" data-name=\"eye icon indicating password hidden\" data-reason=\"icon class rewritten by toggle script on click\"></i></button>\n</div>\n</div>\n</div>\n<div class=\"notes\" data-kid=\"1-3-3\" data-name=\"password requirement notes\">\n<div class=\"note\" data-kid=\"1-3-3-1\" data-name=\"minimum length requirement note\"><i class=\"ri-checkbox-circle-line\" data-kid=\"1-3-3-1-1\" data-name=\"checkmark circle icon\"></i><span data-kid=\"1-3-3-1-2\" data-name=\"minimum length requirement text\">รหัสผ่านต้องมีอย่างน้อย 8 ตัวอักษร</span></div>\n<div class=\"note\" data-kid=\"1-3-3-2\" data-name=\"matching passwords requirement note\"><i class=\"ri-check-line\" data-kid=\"1-3-3-2-1\" data-name=\"checkmark icon\"></i><span data-kid=\"1-3-3-2-2\" data-name=\"matching passwords requirement text\">รหัสผ่านใหม่และการยืนยันตรงกัน</span></div>\n</div>\n<button class=\"primary\" data-kid=\"1-3-4\" data-name=\"primary submit button\" type=\"button\">\n<span data-kid=\"1-3-4-1\" data-name=\"submit button label text\">ตั้งรหัสผ่านใหม่</span>\n</button>\n<button class=\"expired\" data-kid=\"1-3-5\" data-name=\"request new link text action\" type=\"button\">\n      ขอลิงก์ใหม่เนื่องจากลิงก์หมดอายุ\n    </button>\n</div>\n</div>\n<script>\n  document.querySelectorAll('.suf').forEach(function (btn) {\n    btn.addEventListener('click', function () {\n      var input = document.getElementById(btn.dataset.target);\n      var icon = btn.querySelector('i');\n      var hidden = input.type === 'password';\n      input.type = hidden ? 'text' : 'password';\n      icon.className = hidden ? 'ri-eye-line' : 'ri-eye-off-line';\n      btn.setAttribute('aria-label', hidden ? 'ซ่อนรหัสผ่าน' : 'แสดงรหัสผ่าน');\n      input.focus();\n    });\n  });\n</script>",
      "comments": [],
      "created": "2026-11-19T10:44:03.310106+00:00",
      "modified": "2026-11-19T10:47:30.194667+00:00",
      "id": "var_18a81461ad2b",
      "contentHeight": 812
    },
    "var_b6b9dbd59302": {
      "type": "variant",
      "label": "เปลี่ยนรหัสผ่าน",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 2850,
        "y": 0,
        "w": 375,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400;500;600;700;800&display=swap');\n\n:root{\n  --green:#20C96A; --green-dark:#0E9F55; --green-bg:#E8F8EF;\n  --ink:#1E293B; --muted:#64748B; --border:#F1F5F9;\n  --red:#FF4D4F; --red-bg:#FFF1F0;\n}\n*{box-sizing:border-box;-webkit-font-smoothing:antialiased}\nhtml,body{margin:0;padding:0}\nbody{\n  font-family:'Noto Sans Thai','Noto Sans Thai Looped','Segoe UI',Roboto,sans-serif;\n  background:#fff;color:var(--ink);font-size:14px;\n}\n.screen{min-height:100vh;display:flex;flex-direction:column;background:#fff}\n\n/* ── status bar ── */\n.statusbar{height:44px;flex:none;display:flex;align-items:center;justify-content:space-between;\n  padding:0 26px 0 28px;color:var(--ink)}\n.statusbar .t{font-size:13px;font-weight:700;letter-spacing:.2px}\n.statusbar .sys{display:flex;align-items:center;gap:6px;opacity:.85}\n\n/* ── app bar (CleanAppBar) ── */\n.appbar{height:60px;flex:none;display:flex;align-items:center;padding:0 16px;position:relative;\n  background:#fff}\n.appbar .title{position:absolute;left:0;right:0;text-align:center;font-size:18px;font-weight:800;\n  letter-spacing:-.3px;color:var(--ink);pointer-events:none}\n.iconbtn{width:40px;height:40px;flex:none;border-radius:14px;background:#fff;\n  border:1.5px solid var(--border);box-shadow:0 2px 8px rgba(30,41,59,.04);\n  display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--ink);\n  transition:transform .12s ease,background .12s ease}\n.iconbtn:active{transform:scale(.94);background:var(--green-bg)}\n\n/* ── body ── */\n.body{flex:1;padding:24px 24px 0;display:flex;flex-direction:column}\n\n/* stored identity strip */\n.idstrip{min-height:64px;background:var(--green-bg);border-radius:18px;padding:12px 16px;\n  display:flex;align-items:center;gap:12px}\n.idstrip .mark{width:40px;height:40px;flex:none;border-radius:12px;background:#fff;\n  border:1.5px solid rgba(32,201,106,.28);display:flex;align-items:center;justify-content:center;color:var(--green)}\n.idstrip .k{font-size:12px;font-weight:700;color:var(--muted);line-height:1.35}\n.idstrip .v{font-size:14px;font-weight:700;color:var(--ink);line-height:1.35;word-break:break-all}\n\n/* fields */\n.fields{margin-top:20px}\n.group{margin-bottom:14px}\n.group > label{display:block;font-size:13px;font-weight:700;color:var(--muted);margin-bottom:6px}\n.field{height:54px;border-radius:16px;background:#fff;border:1.5px solid var(--border);\n  box-shadow:0 3px 10px rgba(30,41,59,.03);display:flex;align-items:center;padding:0 14px;gap:10px;\n  transition:border-color .15s ease,box-shadow .15s ease}\n.field .lead{flex:none;color:var(--muted);display:flex}\n.field input{flex:1;min-width:0;border:0;outline:0;background:transparent;font-family:inherit;\n  font-size:14px;font-weight:500;color:var(--ink);padding:0}\n.field input::placeholder{color:var(--muted);font-weight:400}\n.field input.pw{letter-spacing:3px;font-size:15px}\n.field .eye{flex:none;width:32px;height:32px;border:0;background:transparent;border-radius:10px;\n  color:var(--muted);display:flex;align-items:center;justify-content:center;cursor:pointer}\n.field .eye:active{background:var(--green-bg)}\n.field.focus{border-color:var(--green);box-shadow:0 0 0 3px rgba(32,201,106,.12)}\n.field.bad{border-color:var(--red);box-shadow:0 0 0 3px rgba(255,77,79,.10)}\n.err{display:none;align-items:center;gap:6px;color:var(--red);font-size:13px;font-weight:600;\n  margin-top:6px;line-height:1.4}\n.err.on{display:flex}\n\n/* requirement line */\n.req{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--muted);margin:20px 0 0}\n.req .ic{color:var(--green);display:flex}\n\n/* primary button */\n.submit{width:100%;margin-top:20px;height:54px;border:0;border-radius:18px;background:var(--green);color:#fff;\n  font-family:inherit;font-size:15px;font-weight:800;letter-spacing:-.2px;cursor:pointer;\n  box-shadow:0 6px 14px rgba(32,201,106,.28);display:flex;align-items:center;justify-content:center;gap:9px;\n  transition:transform .12s ease,box-shadow .12s ease,background .15s ease}\n.submit:active{transform:translateY(1px);box-shadow:0 3px 8px rgba(32,201,106,.24)}\n.submit.busy{background:var(--green-dark);box-shadow:none;cursor:default}\n.spin{width:16px;height:16px;border:2px solid rgba(255,255,255,.45);border-top-color:#fff;\n  border-radius:50%;animation:sp .7s linear infinite;display:none}\n@keyframes sp{to{transform:rotate(360deg)}}\n\n/* recovery link */\n.recover{margin:12px 0 0;text-align:center}\n.recover button{border:0;background:transparent;font-family:inherit;font-size:13px;font-weight:700;\n  color:var(--green-dark);cursor:pointer;padding:8px 10px;border-radius:10px}\n.recover button:active{background:var(--green-bg)}\n\n.foot{margin-top:auto;padding-top:24px;display:flex;flex-direction:column;align-items:center}\n.bar{width:120px;height:5px;border-radius:99px;background:rgba(30,41,59,.16);margin-bottom:14px}\n\n/* snackbar */\n.snack{position:fixed;left:24px;right:24px;bottom:34px;border-radius:14px;padding:13px 16px;\n  display:flex;align-items:center;gap:10px;color:#fff;font-size:13px;font-weight:700;\n  box-shadow:0 10px 24px rgba(30,41,59,.18);opacity:0;transform:translateY(14px);pointer-events:none;\n  transition:opacity .2s ease,transform .2s ease}\n.snack.on{opacity:1;transform:translateY(0)}\n.snack.ok{background:var(--green)}\n.snack.no{background:var(--red)}\n</style>\n<div class=\"screen\" data-kid=\"1\" data-name=\"change password screen container\">\n<div class=\"statusbar\" data-kid=\"1-1\" data-name=\"mobile status bar\">\n<span class=\"t\" data-kid=\"1-1-1\" data-name=\"status bar clock time\">10:34</span>\n<span class=\"sys\" data-kid=\"1-1-2\" data-name=\"status bar system icons group\">\n<svg aria-hidden=\"true\" data-kid=\"1-1-2-1\" data-name=\"cellular signal bars icon\" fill=\"currentColor\" height=\"12\" viewbox=\"0 0 17 12\" width=\"17\">\n<rect height=\"4\" rx=\"1\" width=\"3\" x=\"0\" y=\"8\"></rect><rect height=\"6.4\" rx=\"1\" width=\"3\" x=\"4.7\" y=\"5.6\"></rect>\n<rect height=\"9\" rx=\"1\" width=\"3\" x=\"9.4\" y=\"3\"></rect><rect height=\"12\" opacity=\".35\" rx=\"1\" width=\"3\" x=\"14\" y=\"0\"></rect>\n</svg>\n<svg aria-hidden=\"true\" data-kid=\"1-1-2-2\" data-name=\"wifi signal icon\" fill=\"none\" height=\"12\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"1.6\" viewbox=\"0 0 16 12\" width=\"16\">\n<path d=\"M1.2 4.1a10 10 0 0 1 13.6 0\"></path><path d=\"M3.8 6.9a6.2 6.2 0 0 1 8.4 0\"></path><path d=\"M6.4 9.6a2.4 2.4 0 0 1 3.2 0\"></path>\n</svg>\n<svg aria-hidden=\"true\" data-kid=\"1-1-2-3\" data-name=\"battery level icon\" fill=\"none\" height=\"12\" viewbox=\"0 0 24 12\" width=\"24\">\n<rect height=\"10.4\" rx=\"3\" stroke=\"currentColor\" stroke-opacity=\".45\" stroke-width=\"1.2\" width=\"19\" x=\".8\" y=\".8\"></rect>\n<rect fill=\"currentColor\" height=\"6.4\" rx=\"1.6\" width=\"12.6\" x=\"2.8\" y=\"2.8\"></rect>\n<path d=\"M21.6 4.4v3.2\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-opacity=\".45\" stroke-width=\"1.6\"></path>\n</svg>\n</span>\n</div>\n<header class=\"appbar\" data-kid=\"1-2\" data-name=\"app top bar\">\n<button aria-label=\"ย้อนกลับ\" class=\"iconbtn\" data-kid=\"1-2-1\" data-name=\"back navigation button\" type=\"button\">\n<svg data-kid=\"1-2-1-1\" data-name=\"left chevron back arrow icon\" fill=\"none\" height=\"20\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\" width=\"20\"><path d=\"M15 5l-7 7 7 7\"></path></svg>\n</button>\n<span class=\"title\" data-kid=\"1-2-2\" data-name=\"app bar title text\">เปลี่ยนรหัสผ่าน</span>\n</header>\n<main class=\"body\" data-kid=\"1-3\" data-name=\"main content body\">\n<section class=\"idstrip\" data-kid=\"1-3-1\" data-name=\"stored account identity strip\">\n<span class=\"mark\" data-kid=\"1-3-1-1\" data-name=\"account mark badge container\">\n<svg data-kid=\"1-3-1-1-1\" data-name=\"email icon\" fill=\"none\" height=\"20\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\" width=\"20\">\n<rect height=\"13\" rx=\"2.5\" width=\"18\" x=\"3\" y=\"5.5\"></rect><path d=\"M4.2 7.4l7.1 5a1.2 1.2 0 0 0 1.4 0l7.1-5\"></path>\n</svg>\n</span>\n<span data-kid=\"1-3-1-2\" data-name=\"account label and value block\">\n<span class=\"k\" data-kid=\"1-3-1-2-1\" data-name=\"account field label\">บัญชี</span><br data-kid=\"1-3-1-2-2\" data-name=\"line break\"/>\n<span class=\"v\" data-kid=\"1-3-1-2-3\" data-name=\"stored account email value\">user2@gmail.com</span>\n</span>\n</section>\n<form autocomplete=\"off\" class=\"fields\" data-kid=\"1-3-2\" data-name=\"password change form\" id=\"pwForm\" novalidate=\"\">\n<div class=\"group\" data-kid=\"1-3-2-1\" data-name=\"current password field group\">\n<label data-kid=\"1-3-2-1-1\" data-name=\"current password field label\" for=\"cur\">รหัสผ่านปัจจุบัน</label>\n<div class=\"field\" data-field=\"\" data-kid=\"1-3-2-1-2\" data-name=\"current password input container\">\n<span class=\"lead\" data-kid=\"1-3-2-1-2-1\" data-name=\"input leading icon holder\">\n<svg data-kid=\"1-3-2-1-2-1-1\" data-name=\"lock icon\" fill=\"none\" height=\"18\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\" width=\"18\">\n<rect height=\"9.5\" rx=\"2.5\" width=\"15\" x=\"4.5\" y=\"10.5\"></rect><path d=\"M8 10.5V7.8a4 4 0 0 1 8 0v2.7\"></path><path d=\"M12 14.2v2.1\"></path>\n</svg>\n</span>\n<input aria-describedby=\"curErr\" class=\"pw\" data-kid=\"1-3-2-1-2-2\" data-name=\"current password input field\" id=\"cur\" type=\"password\" value=\"Nutrition2024\"/>\n<button aria-label=\"แสดงรหัสผ่าน\" class=\"eye\" data-eye=\"\" data-kid=\"1-3-2-1-2-3\" data-name=\"show/hide password eye button\" type=\"button\">\n<svg data-dynamic=\"true\" data-kid=\"1-3-2-1-2-3-1\" data-name=\"eye visibility icon\" data-reason=\"icon innerHTML swapped between eye and eye-off by click script\" fill=\"none\" height=\"19\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\" width=\"19\">\n<path d=\"M2.6 12S6.2 5.8 12 5.8 21.4 12 21.4 12 17.8 18.2 12 18.2 2.6 12 2.6 12Z\"></path><circle cx=\"12\" cy=\"12\" r=\"2.4\"></circle>\n</svg>\n</button>\n</div>\n<p class=\"err\" data-dynamic=\"true\" data-kid=\"1-3-2-1-3\" data-name=\"current password error message\" data-reason=\"class toggled on/off and data-msg text replaced by validation script\" id=\"curErr\">\n<svg data-kid=\"1-3-2-1-3-1\" data-name=\"error alert icon\" fill=\"none\" height=\"14\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\" width=\"14\"><circle cx=\"12\" cy=\"12\" r=\"9\"></circle><path d=\"M12 7.5v5.5\"></path><path d=\"M12 16.4v.1\"></path></svg>\n<span data-dynamic=\"true\" data-kid=\"1-3-2-1-3-2\" data-name=\"current password error text\" data-reason=\"data-msg text rewritten by fail() when validation fails\">รหัสผ่านปัจจุบันไม่ถูกต้อง</span>\n</p>\n</div>\n<div class=\"group\" data-kid=\"1-3-2-2\" data-name=\"new password field group\">\n<label data-kid=\"1-3-2-2-1\" data-name=\"new password field label\" for=\"nw\">รหัสผ่านใหม่</label>\n<div class=\"field\" data-field=\"\" data-kid=\"1-3-2-2-2\" data-name=\"new password input container\">\n<span class=\"lead\" data-kid=\"1-3-2-2-2-1\" data-name=\"input leading icon holder\">\n<svg data-kid=\"1-3-2-2-2-1-1\" data-name=\"lock icon\" fill=\"none\" height=\"18\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\" width=\"18\">\n<rect height=\"9.5\" rx=\"2.5\" width=\"15\" x=\"4.5\" y=\"10.5\"></rect><path d=\"M8 10.5V7.8a4 4 0 0 1 8 0v2.7\"></path><path d=\"M12 14.2v2.1\"></path>\n</svg>\n</span>\n<input aria-describedby=\"nwErr\" class=\"pw\" data-kid=\"1-3-2-2-2-2\" data-name=\"new password input field\" id=\"nw\" type=\"password\" value=\"Newpass1234\"/>\n<button aria-label=\"แสดงรหัสผ่าน\" class=\"eye\" data-eye=\"\" data-kid=\"1-3-2-2-2-3\" data-name=\"show/hide password eye button\" type=\"button\">\n<svg data-dynamic=\"true\" data-kid=\"1-3-2-2-2-3-1\" data-name=\"eye visibility icon\" data-reason=\"icon innerHTML swapped between eye and eye-off by click script\" fill=\"none\" height=\"19\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\" width=\"19\">\n<path d=\"M2.6 12S6.2 5.8 12 5.8 21.4 12 21.4 12 17.8 18.2 12 18.2 2.6 12 2.6 12Z\"></path><circle cx=\"12\" cy=\"12\" r=\"2.4\"></circle>\n</svg>\n</button>\n</div>\n<p class=\"err\" data-dynamic=\"true\" data-kid=\"1-3-2-2-3\" data-name=\"new password error message\" data-reason=\"class toggled on/off and data-msg text replaced by validation script\" id=\"nwErr\">\n<svg data-kid=\"1-3-2-2-3-1\" data-name=\"error alert icon\" fill=\"none\" height=\"14\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\" width=\"14\"><circle cx=\"12\" cy=\"12\" r=\"9\"></circle><path d=\"M12 7.5v5.5\"></path><path d=\"M12 16.4v.1\"></path></svg>\n<span data-dynamic=\"true\" data-kid=\"1-3-2-2-3-2\" data-msg=\"\" data-name=\"new password error text\" data-reason=\"data-msg text rewritten by fail() when validation fails\">รหัสผ่านต้องมีอย่างน้อย 8 ตัวอักษร</span>\n</p>\n</div>\n<div class=\"group\" data-kid=\"1-3-2-3\" data-name=\"confirm password field group\" style=\"margin-bottom:0\">\n<label data-kid=\"1-3-2-3-1\" data-name=\"confirm password field label\" for=\"cf\">ยืนยันรหัสผ่านใหม่</label>\n<div class=\"field\" data-field=\"\" data-kid=\"1-3-2-3-2\" data-name=\"confirm password input container\">\n<span class=\"lead\" data-kid=\"1-3-2-3-2-1\" data-name=\"input leading icon holder\">\n<svg data-kid=\"1-3-2-3-2-1-1\" data-name=\"lock icon\" fill=\"none\" height=\"18\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\" width=\"18\">\n<rect height=\"9.5\" rx=\"2.5\" width=\"15\" x=\"4.5\" y=\"10.5\"></rect><path d=\"M8 10.5V7.8a4 4 0 0 1 8 0v2.7\"></path><path d=\"M12 14.2v2.1\"></path>\n</svg>\n</span>\n<input aria-describedby=\"cfErr\" class=\"pw\" data-kid=\"1-3-2-3-2-2\" data-name=\"confirm password input field\" id=\"cf\" type=\"password\" value=\"Newpass1234\"/>\n<button aria-label=\"แสดงรหัสผ่าน\" class=\"eye\" data-eye=\"\" data-kid=\"1-3-2-3-2-3\" data-name=\"show/hide password eye button\" type=\"button\">\n<svg data-dynamic=\"true\" data-kid=\"1-3-2-3-2-3-1\" data-name=\"eye visibility icon\" data-reason=\"icon innerHTML swapped between eye and eye-off by click script\" fill=\"none\" height=\"19\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\" width=\"19\">\n<path d=\"M2.6 12S6.2 5.8 12 5.8 21.4 12 21.4 12 17.8 18.2 12 18.2 2.6 12 2.6 12Z\"></path><circle cx=\"12\" cy=\"12\" r=\"2.4\"></circle>\n</svg>\n</button>\n</div>\n<p class=\"err\" data-dynamic=\"true\" data-kid=\"1-3-2-3-3\" data-name=\"confirm password error message\" data-reason=\"class toggled on/off and data-msg text replaced by validation script\" id=\"cfErr\">\n<svg data-kid=\"1-3-2-3-3-1\" data-name=\"error alert icon\" fill=\"none\" height=\"14\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\" width=\"14\"><circle cx=\"12\" cy=\"12\" r=\"9\"></circle><path d=\"M12 7.5v5.5\"></path><path d=\"M12 16.4v.1\"></path></svg>\n<span data-dynamic=\"true\" data-kid=\"1-3-2-3-3-2\" data-msg=\"\" data-name=\"confirm password error text\" data-reason=\"data-msg text rewritten by fail() when validation fails\">รหัสผ่านใหม่และการยืนยันไม่ตรงกัน</span>\n</p>\n</div>\n<p class=\"req\" data-kid=\"1-3-2-4\" data-name=\"password requirement hint row\">\n<span class=\"ic\" data-kid=\"1-3-2-4-1\" data-name=\"requirement info icon holder\">\n<svg data-kid=\"1-3-2-4-1-1\" data-name=\"green checkmark icon\" fill=\"none\" height=\"14\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\" width=\"14\"><circle cx=\"12\" cy=\"12\" r=\"8.6\"></circle><path d=\"M8.4 12.3l2.4 2.4 4.8-5\"></path></svg>\n</span>\n        รหัสผ่านต้องมีอย่างน้อย 8 ตัวอักษร\n      </p>\n<button class=\"submit\" data-kid=\"1-3-2-5\" data-name=\"submit change password button\" id=\"submitBtn\" type=\"submit\">\n<span class=\"spin\" data-dynamic=\"true\" data-kid=\"1-3-2-5-1\" data-name=\"loading spinner\" data-reason=\"display style toggled by script while busy\" id=\"spin\"></span>\n<span data-dynamic=\"true\" data-kid=\"1-3-2-5-2\" data-name=\"submit button label text\" data-reason=\"text set to busy state and back by submit script\" id=\"submitLabel\">เปลี่ยนรหัสผ่าน</span>\n</button>\n<p class=\"recover\" data-kid=\"1-3-2-6\" data-name=\"recover password link container\"><button data-kid=\"1-3-2-6-1\" data-name=\"forgot password link button\" id=\"recoverBtn\" type=\"button\">จำรหัสผ่านปัจจุบันไม่ได้?</button></p>\n</form>\n<div class=\"foot\" data-kid=\"1-3-3\" data-name=\"footer area\"><span class=\"bar\" data-kid=\"1-3-3-1\" data-name=\"home indicator bar\"></span></div>\n</main>\n</div>\n<div class=\"snack\" data-dynamic=\"true\" data-kid=\"2\" data-name=\"toast/snackbar notification container\" data-reason=\"class toggled on/off and message text set by toast()\" id=\"snack\">\n<svg data-kid=\"2-1\" data-name=\"toast success checkmark icon\" fill=\"none\" height=\"18\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\" width=\"18\"><circle cx=\"12\" cy=\"12\" r=\"8.6\"></circle><path d=\"M8.4 12.3l2.4 2.4 4.8-5\"></path></svg>\n<span data-dynamic=\"true\" data-kid=\"2-2\" data-name=\"toast message text\" data-reason=\"textContent replaced by toast() on each event\" id=\"snackText\"></span>\n</div>\n<script>\n(function(){\n  var EYE_ON = '<svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M2.6 12S6.2 5.8 12 5.8 21.4 12 21.4 12 17.8 18.2 12 18.2 2.6 12 2.6 12Z\"/><circle cx=\"12\" cy=\"12\" r=\"2.4\"/></svg>';\n  var EYE_OFF = '<svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 4l16 16\"/><path d=\"M9.6 6.2A9.6 9.6 0 0 1 12 5.8c5.8 0 9.4 6.2 9.4 6.2a17 17 0 0 1-3.2 3.9\"/><path d=\"M6.4 8.2A16.6 16.6 0 0 0 2.6 12S6.2 18.2 12 18.2c1.4 0 2.6-.3 3.7-.8\"/><path d=\"M10 10.2a2.4 2.4 0 0 0 3.4 3.4\"/></svg>';\n\n  document.querySelectorAll('[data-eye]').forEach(function(btn){\n    btn.addEventListener('click', function(){\n      var input = btn.parentElement.querySelector('input');\n      var show = input.type === 'password';\n      input.type = show ? 'text' : 'password';\n      btn.innerHTML = show ? EYE_OFF : EYE_ON;\n      btn.setAttribute('aria-label', show ? 'ซ่อนรหัสผ่าน' : 'แสดงรหัสผ่าน');\n      input.focus();\n    });\n  });\n\n  document.querySelectorAll('[data-field] input').forEach(function(input){\n    var box = input.parentElement;\n    input.addEventListener('focus', function(){ box.classList.add('focus'); });\n    input.addEventListener('blur', function(){ box.classList.remove('focus'); });\n    input.addEventListener('input', function(){\n      if(box.classList.contains('bad')){ box.classList.remove('bad'); box.nextElementSibling.classList.remove('on'); }\n    });\n  });\n\n  var snack = document.getElementById('snack'), snackText = document.getElementById('snackText'), snackTimer;\n  function toast(msg, ok){\n    snackText.textContent = msg;\n    snack.className = 'snack on ' + (ok ? 'ok' : 'no');\n    clearTimeout(snackTimer);\n    snackTimer = setTimeout(function(){ snack.classList.remove('on'); }, 2600);\n  }\n\n  function fail(input, msg){\n    var box = input.parentElement;\n    box.classList.add('bad'); box.classList.remove('focus');\n    var err = box.nextElementSibling;\n    if(msg){ err.querySelector('[data-msg]').textContent = msg; }\n    err.classList.add('on');\n    return input;\n  }\n\n  var form = document.getElementById('pwForm'),\n      cur = document.getElementById('cur'), nw = document.getElementById('nw'), cf = document.getElementById('cf'),\n      btn = document.getElementById('submitBtn'), spin = document.getElementById('spin'), label = document.getElementById('submitLabel');\n\n  form.addEventListener('submit', function(e){\n    e.preventDefault();\n    if(btn.classList.contains('busy')) return;\n\n    var first = null;\n    if(!cur.value){ first = first || fail(cur, 'กรุณากรอกรหัสผ่านปัจจุบัน'); }\n    if(nw.value.length < 8){ first = first || fail(nw, 'รหัสผ่านต้องมีอย่างน้อย 8 ตัวอักษร'); }\n    else if(nw.value === cur.value){ first = first || fail(nw, 'รหัสผ่านใหม่ต้องไม่ซ้ำกับรหัสผ่านเดิม'); }\n    if(cf.value !== nw.value){ first = first || fail(cf, 'รหัสผ่านใหม่และการยืนยันไม่ตรงกัน'); }\n\n    if(first){ first.focus(); return; }\n\n    btn.classList.add('busy'); spin.style.display = 'block'; label.textContent = 'กำลังบันทึก…';\n    setTimeout(function(){\n      btn.classList.remove('busy'); spin.style.display = 'none'; label.textContent = 'เปลี่ยนรหัสผ่าน';\n      cur.value = ''; nw.value = ''; cf.value = '';\n      toast('บันทึกรหัสผ่านใหม่เรียบร้อยแล้ว', true);\n    }, 900);\n  });\n\n  document.getElementById('recoverBtn').addEventListener('click', function(){\n    toast('ลิงก์ตั้งรหัสผ่านใหม่ถูกส่งไปที่ user2@gmail.com แล้ว', true);\n  });\n})();\n</script>",
      "comments": [],
      "created": "2026-11-19T10:44:32.738282+00:00",
      "modified": "2026-11-19T10:47:17.341368+00:00",
