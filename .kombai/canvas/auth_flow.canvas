    "var_c5a50f3e73c3": {
      "type": "variant",
      "label": "ลืมรหัสผ่าน",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1425,
        "y": 0,
        "w": 375,
        "h": 0
      },
      "html": "<style>\n@import url(\"https://cdn.jsdelivr.net/npm/@mdi/font@7.4.47/css/materialdesignicons.min.css\");\n\n* { box-sizing: border-box; }\nhtml, body { margin: 0; padding: 0; }\nbody {\n  font-family: \"Segoe UI\", Roboto, \"Noto Sans Thai\", \"Leelawadee UI\", sans-serif;\n  background: #FFFFFF;\n  color: #1E293B;\n  -webkit-font-smoothing: antialiased;\n}\n.screen {\n  min-height: 812px;\n  display: flex;\n  flex-direction: column;\n  background: #FFFFFF;\n}\n\n/* ── status chrome ── */\n.status {\n  height: 44px;\n  flex: none;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 0 20px 0 22px;\n  font-size: 13px;\n  font-weight: 600;\n  color: #1E293B;\n}\n.status .right { font-size: 15px; color: #64748B; letter-spacing: 2px; }\n\n/* ── app bar (CleanAppBar) ── */\n.appbar {\n  height: 60px;\n  flex: none;\n  position: relative;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: #FFFFFF;\n  border-bottom: 1px solid #F1F5F9;\n}\n.appbar h1 {\n  margin: 0;\n  font-size: 18px;\n  font-weight: 800;\n  letter-spacing: -0.3px;\n  color: #1E293B;\n}\n.backbtn {\n  position: absolute;\n  left: 16px;\n  top: 50%;\n  transform: translateY(-50%);\n  width: 44px;\n  height: 44px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  border-radius: 14px;\n  border: 1.5px solid #F1F5F9;\n  background: #FFFFFF;\n  box-shadow: 0 2px 8px rgba(30, 41, 59, 0.04);\n  color: #1E293B;\n  font-size: 16px;\n  cursor: pointer;\n}\n\n/* ── body ── */\n.body { flex: 1 1 auto; padding: 24px; display: flex; flex-direction: column; }\n\n.lead { font-size: 22px; font-weight: 800; letter-spacing: -0.3px; color: #1E293B; margin: 0; }\n.explain { margin: 6px 0 0; font-size: 13px; line-height: 1.5; color: #64748B; max-width: 300px; }\n\n.label {\n  margin: 24px 0 8px;\n  font-size: 13px;\n  font-weight: 700;\n  color: #64748B;\n}\n.field {\n  height: 54px;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 0 18px;\n  background: #FFFFFF;\n  border: 1.5px solid #F1F5F9;\n  border-radius: 16px;\n  box-shadow: 0 3px 10px rgba(30, 41, 59, 0.03);\n}\n.field .mdi { font-size: 18px; color: #64748B; line-height: 1; }\n.field input {\n  flex: 1 1 auto;\n  min-width: 0;\n  border: 0;\n  outline: 0;\n  background: transparent;\n  font: inherit;\n  font-size: 14px;\n  font-weight: 500;\n  color: #1E293B;\n}\n.field input::placeholder { color: #64748B; font-weight: 400; }\n.field:focus-within { border-color: #20C96A; box-shadow: 0 3px 12px rgba(32, 201, 106, 0.12); }\n\n.sendbtn {\n  margin-top: 20px;\n  height: 54px;\n  width: 100%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  border: 0;\n  border-radius: 18px;\n  background: #20C96A;\n  color: #FFFFFF;\n  font: inherit;\n  font-size: 15px;\n  font-weight: 800;\n  letter-spacing: -0.2px;\n  box-shadow: 0 6px 14px rgba(32, 201, 106, 0.28);\n  cursor: pointer;\n  transition: transform 0.12s ease, box-shadow 0.12s ease;\n}\n.sendbtn .mdi { font-size: 19px; }\n.sendbtn:active { transform: translateY(1px); box-shadow: 0 3px 8px rgba(32, 201, 106, 0.24); }\n\n.backlink {\n  margin: 16px 0 0;\n  text-align: center;\n  font-size: 13px;\n  font-weight: 700;\n  color: #0E9F55;\n}\n\n.note {\n  margin-top: auto;\n  margin-bottom: 8px;\n  display: flex;\n  align-items: flex-start;\n  gap: 8px;\n  font-size: 12px;\n  line-height: 1.45;\n  color: #64748B;\n}\n.note .mdi { font-size: 15px; color: #0E9F55; line-height: 1.2; }\n\n.home { height: 22px; flex: none; margin-top: 12px; }\n</style>\n<div class=\"screen\" data-kid=\"1\" data-name=\"reset password mobile screen\">\n<div class=\"status\" data-kid=\"1-1\" data-name=\"device status bar\">\n<span data-kid=\"1-1-1\" data-name=\"status bar clock text\">9:41</span>\n<span class=\"right\" data-kid=\"1-1-2\" data-name=\"status bar signal and battery icons\"><span class=\"mdi mdi-signal-cellular-3\" data-kid=\"1-1-2-1\" data-name=\"mobile signal strength icon\"></span><span class=\"mdi mdi-battery\" data-kid=\"1-1-2-2\" data-name=\"battery level icon\"></span></span>\n</div>\n<header class=\"appbar\" data-kid=\"1-2\" data-name=\"app bar with back navigation and title\">\n<button aria-label=\"ย้อนกลับ\" class=\"backbtn\" data-kid=\"1-2-1\" data-name=\"back navigation button\" type=\"button\"><span class=\"mdi mdi-chevron-left\" data-kid=\"1-2-1-1\" data-name=\"chevron left back arrow icon\"></span></button>\n<h1 data-kid=\"1-2-2\" data-name=\"app bar page title\">ลืมรหัสผ่าน</h1>\n</header>\n<main class=\"body\" data-kid=\"1-3\" data-name=\"main form body area\">\n<h2 class=\"lead\" data-kid=\"1-3-1\" data-name=\"form heading text\">ตั้งรหัสผ่านใหม่</h2>\n<p class=\"explain\" data-kid=\"1-3-2\" data-name=\"form instruction explanation text\">กรอกอีเมลที่ใช้สมัครบัญชี เราจะส่งลิงก์ตั้งรหัสผ่านใหม่ไปให้</p>\n<p class=\"label\" data-kid=\"1-3-3\" data-name=\"email field label\">อีเมล</p>\n<div class=\"field\" data-kid=\"1-3-4\" data-name=\"email input field container\">\n<span class=\"mdi mdi-email-outline\" data-kid=\"1-3-4-1\" data-name=\"email outline icon\"></span>\n<input autocomplete=\"email\" data-kid=\"1-3-4-2\" data-name=\"email address input field\" placeholder=\"name@example.com\" type=\"email\"/>\n</div>\n<button class=\"sendbtn\" data-kid=\"1-3-5\" data-name=\"send password reset link button\" type=\"button\">\n<span class=\"mdi mdi-send-outline\" data-kid=\"1-3-5-1\" data-name=\"send outline icon\"></span>\n      ส่งลิงก์ตั้งรหัสผ่าน\n    </button>\n<p class=\"backlink\" data-kid=\"1-3-6\" data-name=\"back to sign in link text\">กลับสู่หน้าเข้าสู่ระบบ</p>\n<p class=\"note\" data-kid=\"1-3-7\" data-name=\"link expiration security note\">\n<span class=\"mdi mdi-shield-lock-outline\" data-kid=\"1-3-7-1\" data-name=\"shield lock outline icon\"></span>\n<span data-kid=\"1-3-7-2\" data-name=\"link expiration note text\">ลิงก์ตั้งรหัสผ่านหมดอายุภายใน 30 นาที</span>\n</p>\n</main>\n<div class=\"home\" data-kid=\"1-4\" data-name=\"home indicator bar\"></div>\n</div>",
