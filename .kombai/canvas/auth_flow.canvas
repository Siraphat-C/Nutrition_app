      },
      "html": "<style>\n  @import url(\"https://cdn.jsdelivr.net/npm/remixicon@4.9.1/fonts/remixicon.css\");\n\n  * { box-sizing: border-box; }\n  html, body { margin: 0; padding: 0; }\n  body {\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Noto Sans Thai\", \"Leelawadee UI\", Tahoma, sans-serif;\n    background: #FFFFFF;\n    color: #1E293B;\n    -webkit-font-smoothing: antialiased;\n  }\n\n  /* ── app bar (CleanAppBar) ── */\n  .appbar {\n    position: sticky; top: 0; z-index: 5;\n    height: 60px; background: #FFFFFF;\n    border-bottom: 1px solid #F1F5F9;\n    display: flex; align-items: center; gap: 8px;\n    padding: 0 24px;\n  }\n  .appbar__back {\n    width: 40px; height: 40px; flex: 0 0 40px;\n    border: 1.5px solid #F1F5F9; border-radius: 14px;\n    background: #FFFFFF; color: #1E293B;\n    display: flex; align-items: center; justify-content: center;\n    cursor: pointer;\n    transition: border-color .15s ease, background-color .15s ease;\n  }\n  .appbar__back:hover { border-color: rgba(32, 201, 106, .45); background: #F8FDFA; }\n  .appbar__back i { font-size: 20px; line-height: 1; }\n  .appbar__title {\n    flex: 1; text-align: center;\n    font-size: 18px; font-weight: 800; letter-spacing: -.2px; color: #1E293B;\n  }\n  .appbar__spacer { width: 40px; flex: 0 0 40px; }\n\n  .page { padding: 24px; }\n\n  /* ── result region (Done state) ── */\n  .result {\n    background: #E8F8EF;\n    border: 1px solid rgba(32, 201, 106, .18);\n    border-radius: 24px;\n    padding: 24px;\n    animation: resultIn .32s ease-out both;\n  }\n  @keyframes resultIn {\n    from { opacity: 0; transform: translateY(6px); }\n    to   { opacity: 1; transform: none; }\n  }\n  .result__badge {\n    width: 56px; height: 56px; border-radius: 50%;\n    background: #FFFFFF;\n    border: 1.5px solid rgba(32, 201, 106, .30);\n    display: flex; align-items: center; justify-content: center;\n    color: #20C96A;\n  }\n  .result__badge i { font-size: 26px; line-height: 1; }\n  .result__title {\n    margin: 16px 0 0; font-size: 18px; font-weight: 800; color: #1E293B; letter-spacing: -.2px;\n  }\n  .result__body {\n    margin: 8px 0 0; font-size: 14px; line-height: 1.55; color: rgba(30, 41, 59, .80);\n  }\n\n  /* ── disabled resend ── */\n  .resend { margin-top: 20px; }\n  .resend__btn {\n    height: 44px; width: 100%;\n    display: flex; align-items: center; justify-content: center; gap: 8px;\n    background: #F1F5F9; color: #64748B;\n    border: 1.5px solid #E7ECF2; border-radius: 14px;\n    font-size: 13px; font-weight: 700; cursor: not-allowed;\n  }\n  .resend__btn i { font-size: 14px; line-height: 1; }\n  .resend__timer {\n    margin-top: 6px; text-align: center;\n    font-size: 12px; font-weight: 500; color: #64748B;\n    font-variant-numeric: tabular-nums;\n  }\n\n  /* ── primary button (PrimaryButton) ── */\n  .primary {\n    margin-top: 20px; height: 54px; width: 100%;\n    display: flex; align-items: center; justify-content: center; gap: 10px;\n    background: #20C96A; color: #FFFFFF;\n    border: 0; border-radius: 18px; cursor: pointer;\n    font-family: inherit; font-size: 15px; font-weight: 800; letter-spacing: -.1px;\n    box-shadow: 0 8px 16px rgba(32, 201, 106, .28);\n    transition: background-color .15s ease, box-shadow .15s ease;\n  }\n  .primary:hover { background: #0E9F55; box-shadow: 0 6px 14px rgba(14, 159, 85, .26); }\n  .primary i { font-size: 18px; line-height: 1; }\n</style>\n<header class=\"appbar\" data-kid=\"1\" data-name=\"app bar header\">\n<button aria-label=\"ย้อนกลับ\" class=\"appbar__back\" data-kid=\"1-1\" data-name=\"back navigation button\" type=\"button\">\n<i aria-hidden=\"true\" class=\"ri-arrow-left-s-line\" data-kid=\"1-1-1\" data-name=\"left arrow icon\"></i>\n</button>\n<span class=\"appbar__title\" data-kid=\"1-2\" data-name=\"app bar page title\">ลืมรหัสผ่าน</span>\n<span aria-hidden=\"true\" class=\"appbar__spacer\" data-kid=\"1-3\" data-name=\"spacer for title centering\"></span>\n</header>\n<main class=\"page\" data-kid=\"2\" data-name=\"main page container\">\n<section class=\"result\" data-kid=\"2-1\" data-name=\"sent-confirmation result card\">\n<div class=\"result__badge\" data-kid=\"2-1-1\" data-name=\"success badge circle\"><i aria-hidden=\"true\" class=\"ri-mail-open-line\" data-kid=\"2-1-1-1\" data-name=\"open envelope icon\"></i></div>\n<h1 class=\"result__title\" data-kid=\"2-1-2\" data-name=\"confirmation headline\">ส่งลิงก์ตั้งรหัสผ่านแล้ว</h1>\n<p class=\"result__body\" data-kid=\"2-1-3\" data-name=\"confirmation description text\">หากอีเมลนี้ผูกกับบัญชี คุณจะได้รับลิงก์ภายในไม่กี่นาที</p>\n</section>\n<div class=\"resend\" data-kid=\"2-2\" data-name=\"resend action block\">\n<button class=\"resend__btn\" data-kid=\"2-2-1\" data-name=\"disabled resend button\" disabled=\"\" type=\"button\">\n<i aria-hidden=\"true\" class=\"ri-refresh-line\" data-kid=\"2-2-1-1\" data-name=\"refresh icon\"></i>\n<span data-kid=\"2-2-1-2\" data-name=\"resend button label\">ส่งลิงก์อีกครั้ง</span>\n</button>\n<p class=\"resend__timer\" data-kid=\"2-2-2\" data-name=\"resend countdown caption\">ส่งได้อีกครั้งใน <span data-dynamic=\"true\" data-kid=\"2-2-2-1\" data-name=\"countdown timer value\" data-reason=\"text replaced every second by countdown script\" id=\"resendCountdown\">0:45</span></p>\n</div>\n<button class=\"primary\" data-kid=\"2-3\" data-name=\"primary return-to-login button\" type=\"button\">\n<i aria-hidden=\"true\" class=\"ri-arrow-go-back-line\" data-kid=\"2-3-1\" data-name=\"back arrow line icon\"></i>\n<span data-kid=\"2-3-2\" data-name=\"return-to-login button label\">กลับสู่หน้าเข้าสู่ระบบ</span>\n</button>\n</main>\n<script>\n  (function () {\n    var el = document.getElementById(\"resendCountdown\");\n    var left = 45;\n    function pad(n) { return n < 10 ? \"0\" + n : \"\" + n; }\n    var id = setInterval(function () {\n      left -= 1;\n      if (left <= 0) { clearInterval(id); return; }\n      el.textContent = \"0:\" + pad(left);\n    }, 1000);\n  })();\n</script>",
