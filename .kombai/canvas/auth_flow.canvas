      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;500;600;700&display=swap');\n@import url('https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20,400,0,0&display=swap');\n\n* { box-sizing: border-box; }\nhtml, body { margin: 0; padding: 0; }\nbody { background: #FFFFFF; }\n\n.ms {\n  font-family: 'Material Symbols Rounded';\n  font-weight: normal;\n  font-style: normal;\n  line-height: 1;\n  letter-spacing: normal;\n  text-transform: none;\n  display: inline-block;\n  white-space: nowrap;\n  word-wrap: normal;\n  direction: ltr;\n  font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'OPSZ' 20;\n  -webkit-font-smoothing: antialiased;\n}\n.ms.fill { font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'OPSZ' 20; }\n\n.screen {\n  width: 375px;\n  min-height: 100vh;\n  background: #FFFFFF;\n  font-family: 'IBM Plex Sans Thai', 'Noto Sans Thai', sans-serif;\n  color: #1E293B;\n  -webkit-font-smoothing: antialiased;\n}\n\n/* ── CleanAppBar ── */\n.appbar {\n  height: 60px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: #FFFFFF;\n  border-bottom: 1.5px solid #F1F5F9;\n}\n.appbar h1 {\n  margin: 0;\n  font-size: 18px;\n  font-weight: 700;\n  letter-spacing: -0.3px;\n  color: #1E293B;\n}\n\n/* ── page ── */\n.page { padding: 24px; }\n\n/* identity header */\n.brand { display: flex; align-items: center; gap: 16px; }\n.brand-tile {\n  width: 76px; height: 76px; flex: none;\n  border-radius: 24px;\n  background: #E8F8EF;\n  border: 1.5px solid rgba(32,201,106,0.30);\n  display: flex; align-items: center; justify-content: center;\n}\n.brand-tile .ms { font-size: 38px; color: #20C96A; }\n.brand-text { min-width: 0; }\n.brand-text .name {\n  font-size: 26px; font-weight: 700; letter-spacing: -0.5px;\n  color: #1E293B; line-height: 1.25;\n}\n.brand-text .sub {\n  font-size: 14px; font-weight: 400; color: #64748B; line-height: 1.4;\n  margin-top: 4px;\n}\n\n/* fields */\n.form { margin-top: 20px; }\n.field { margin-bottom: 14px; }\n.label {\n  font-size: 13px; font-weight: 600; color: #64748B;\n  letter-spacing: 0.1px;\n  margin-bottom: 8px;\n}\n.input {\n  height: 54px;\n  border-radius: 16px;\n  background: #FFFFFF;\n  border: 1.5px solid #F1F5F9;\n  box-shadow: 0 3px 10px rgba(30,41,59,0.03);\n  display: flex; align-items: center;\n  padding: 0 16px 0 14px;\n  gap: 10px;\n}\n.input .lead { font-size: 20px; color: #64748B; flex: none; }\n.input .val {\n  flex: 1 1 auto; min-width: 0;\n  font-size: 14px; font-weight: 500; color: #1E293B;\n  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;\n}\n.input.error { border-color: #FF4D4F; box-shadow: 0 3px 10px rgba(255,77,79,0.06); }\n.input.error .eye { font-size: 19px; color: #FF4D4F; flex: none; }\n.dots { font-size: 17px; letter-spacing: 2.5px; color: #1E293B; line-height: 1; }\n\n/* inline field error */\n.field-msg {\n  display: flex; align-items: center; gap: 6px;\n  margin: 8px 0 0 2px;\n}\n.field-msg .ms { font-size: 15px; color: #FF4D4F; flex: none; }\n.field-msg span.txt { font-size: 13px; font-weight: 600; color: #FF4D4F; line-height: 1.4; }\n\n/* forgot link */\n.forgot {\n  display: flex; justify-content: flex-end;\n  margin-top: 6px;\n}\n.forgot a {\n  font-size: 13px; font-weight: 600; color: #0E9F55;\n  text-decoration: none; padding: 4px 2px;\n}\n\n/* service-level failure region */\n.banner {\n  margin-top: 20px;\n  background: #FFF1F0;\n  border-radius: 16px;\n  padding: 14px 16px;\n  display: flex; gap: 12px; align-items: flex-start;\n}\n.banner .ms { font-size: 20px; color: #FF4D4F; flex: none; margin-top: 2px; }\n.banner .t { font-size: 14px; font-weight: 700; color: #1E293B; line-height: 1.35; }\n.banner .d { font-size: 13px; font-weight: 400; color: #64748B; line-height: 1.45; margin-top: 3px; }\n\n/* primary button */\n.btn-primary {\n  margin-top: 20px;\n  width: 100%; height: 54px;\n  border: none; border-radius: 18px;\n  background: #20C96A; color: #FFFFFF;\n  font-family: inherit;\n  font-size: 15px; font-weight: 700; letter-spacing: -0.2px;\n  display: flex; align-items: center; justify-content: center; gap: 8px;\n  box-shadow: 0 6px 14px rgba(32,201,106,0.28);\n}\n.btn-primary .ms { font-size: 20px; color: #FFFFFF; }\n\n/* register line */\n.signup-row {\n  margin-top: 16px;\n  min-height: 48px;\n  display: flex; align-items: center; justify-content: center; gap: 4px;\n}\n.signup-row .q { font-size: 13px; color: #64748B; }\n.signup-row .a { font-size: 13px; font-weight: 700; color: #0E9F55; text-decoration: none; padding: 6px 2px; }\n\n/* admin entry */\n.admin-sep {\n  margin: 20px 0 0;\n  height: 1.5px;\n  background: #F1F5F9;\n}\n.admin-row {\n  margin-top: 0;\n  min-height: 44px;\n  display: flex; align-items: center; justify-content: center; gap: 8px;\n}\n.admin-row .ms { font-size: 18px; color: #0E9F55; flex: none; }\n.admin-row .txt { font-size: 13px; font-weight: 600; color: #0E9F55; }\n.safe-bottom { height: 32px; }\n</style>\n<div class=\"screen\" data-kid=\"1\" data-name=\"mobile login form screen container\">\n<div class=\"appbar\" data-kid=\"1-1\" data-name=\"app top bar false\"><h1 data-kid=\"1-1-1\" data-name=\"app bar brand title text\">วิเคราะห์โภชนาการ</h1></div>\n<div class=\"page\" data-kid=\"1-2\" data-name=\"page content wrapper\">\n<div class=\"brand\" data-kid=\"1-2-1\" data-name=\"brand identity header\">\n<div class=\"brand-tile\" data-kid=\"1-2-1-1\" data-name=\"brand logo tile\"><i class=\"ms fill\" data-kid=\"1-2-1-1-1\" data-name=\"restaurant icon\">restaurant</i></div>\n<div class=\"brand-text\" data-kid=\"1-2-1-2\" data-name=\"brand name and tagline text block\">\n<div class=\"name\" data-kid=\"1-2-1-2-1\" data-name=\"brand name headline\">วิเคราะห์โภชนาการ</div>\n<div class=\"sub\" data-kid=\"1-2-1-2-2\" data-name=\"brand tagline subtitle\">สแกนอาหาร คำนวณแคลอรี่</div>\n</div>\n</div>\n<div class=\"form\" data-kid=\"1-2-2\" data-name=\"login form\">\n<div class=\"field\" data-kid=\"1-2-2-1\" data-name=\"email input field\">\n<div class=\"label\" data-kid=\"1-2-2-1-1\" data-name=\"email field label\">อีเมล</div>\n<div class=\"input\" data-kid=\"1-2-2-1-2\" data-name=\"email input container\">\n<i class=\"ms lead\" data-kid=\"1-2-2-1-2-1\" data-name=\"envelope mail icon\">mail</i>\n<div class=\"val\" data-kid=\"1-2-2-1-2-2\" data-name=\"email input value text\">user2@gmail.com</div>\n</div>\n</div>\n<div class=\"field\" data-kid=\"1-2-2-2\" data-name=\"password input field\" style=\"margin-bottom: 0;\">\n<div class=\"label\" data-kid=\"1-2-2-2-1\" data-name=\"password field label\">รหัสผ่าน</div>\n<div class=\"input error\" data-kid=\"1-2-2-2-2\" data-name=\"password input container with error state\">\n<i class=\"ms lead\" data-kid=\"1-2-2-2-2-1\" data-name=\"lock icon\">lock</i>\n<div class=\"val\" data-kid=\"1-2-2-2-2-2\" data-name=\"password masked value wrapper\"><span class=\"dots\" data-kid=\"1-2-2-2-2-2-1\" data-name=\"masked password dots text\">••••••••••••</span></div>\n<i class=\"ms eye\" data-kid=\"1-2-2-2-2-3\" data-name=\"hide password visibility icon\">visibility_off</i>\n</div>\n<div class=\"field-msg\" data-kid=\"1-2-2-2-3\" data-name=\"inline password field error message\">\n<i class=\"ms\" data-kid=\"1-2-2-2-3-1\" data-name=\"error warning icon\">error</i>\n<span class=\"txt\" data-kid=\"1-2-2-2-3-2\" data-name=\"field error message text\">กรอกรหัสผ่านให้ถูกต้อง</span>\n</div>\n<div class=\"forgot\" data-kid=\"1-2-2-2-4\" data-name=\"forgot password link row\"><a data-kid=\"1-2-2-2-4-1\" data-name=\"forgot password link\">ลืมรหัสผ่าน?</a></div>\n</div>\n<div class=\"banner\" data-kid=\"1-2-2-3\" data-name=\"service-level failure banner\">\n<i class=\"ms\" data-kid=\"1-2-2-3-1\" data-name=\"banner error icon\">error</i>\n<div data-kid=\"1-2-2-3-2\" data-name=\"banner text block\">\n<div class=\"t\" data-kid=\"1-2-2-3-2-1\" data-name=\"failure banner title\">อีเมลหรือรหัสผ่านไม่ถูกต้อง</div>\n<div class=\"d\" data-kid=\"1-2-2-3-2-2\" data-name=\"failure banner description text\">ลองตรวจสอบตัวพิมพ์ใหญ่-เล็ก หรือสมัครสมาชิกใหม่</div>\n</div>\n</div>\n<button class=\"btn-primary\" data-kid=\"1-2-2-4\" data-name=\"primary login call-to-action button\"><i class=\"ms\" data-kid=\"1-2-2-4-1\" data-name=\"login arrow icon\">login</i>เข้าสู่ระบบ</button>\n<div class=\"signup-row\" data-kid=\"1-2-2-5\" data-name=\"sign-up prompt row\">\n<span class=\"q\" data-kid=\"1-2-2-5-1\" data-name=\"sign-up prompt question text\">ยังไม่มีบัญชีใช่ไหม?</span>\n<a class=\"a\" data-kid=\"1-2-2-5-2\" data-name=\"new account registration link\">สมัครสมาชิกใหม่</a>\n</div>\n<div class=\"admin-sep\" data-kid=\"1-2-2-6\" data-name=\"admin section divider line\"></div>\n<div class=\"admin-row\" data-kid=\"1-2-2-7\" data-name=\"admin login entry row\">\n<i class=\"ms\" data-kid=\"1-2-2-7-1\" data-name=\"admin panel settings icon\">admin_panel_settings</i>\n<span class=\"txt\" data-kid=\"1-2-2-7-2\" data-name=\"admin login link text\">เข้าสู่ระบบสำหรับผู้ดูแลระบบ</span>\n</div>\n</div>\n</div>\n<div class=\"safe-bottom\" data-kid=\"1-3\" data-name=\"bottom safe area spacer\"></div>\n</div>",
