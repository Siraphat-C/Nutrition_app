    "var_0cd1ce1257db": {
      "type": "variant",
      "label": "เข้าสู่ระบบ · รหัสผ่านไม่ถูกต้อง",
      "parentId": "var_809bb0ef66fc",
      "themeId": null,
      "rect": {
        "x": 3800,
