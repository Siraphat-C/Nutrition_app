    "var_809bb0ef66fc": {
      "type": "variant",
      "label": "เข้าสู่ระบบ",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 3325,
        "y": 0,
        "w": 375,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400..800&display=block');\n@import url('https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,300..700,0..1,0&display=block');\n\n* { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }\nhtml { background: #FFFFFF; }\nbody {\n  width: 375px;\n  min-height: 812px;\n  background: #FFFFFF;\n  font-family: 'Noto Sans Thai', system-ui, -apple-system, sans-serif;\n  color: #1E293B;\n  -webkit-font-smoothing: antialiased;\n  display: flex;\n  flex-direction: column;\n}\n.msy {\n  font-family: 'Material Symbols Rounded', sans-serif;\n  font-weight: 400;\n  font-style: normal;\n  line-height: 1;\n  letter-spacing: normal;\n  text-transform: none;\n  display: inline-block;\n  white-space: nowrap;\n  direction: ltr;\n  font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n  user-select: none;\n}\n.msy.fill { font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24; }\n\n/* ── device chrome ── */\n.statusbar {\n  height: 44px; flex: none;\n  display: flex; align-items: center; justify-content: space-between;\n  padding: 0 24px;\n}\n.statusbar .t { font-size: 15px; font-weight: 700; letter-spacing: -0.2px; }\n.statusbar .sys { display: flex; align-items: center; gap: 6px; color: #1E293B; }\n.statusbar .sys .msy { font-size: 17px; color: #1E293B; }\n\n/* ── app bar (level 0, hairline only) ── */\n.appbar {\n  height: 60px; flex: none;\n  display: flex; align-items: center; justify-content: center;\n  border-bottom: 1px solid #F1F5F9;\n}\n.appbar h1 { font-size: 18px; font-weight: 800; letter-spacing: -0.3px; color: #1E293B; }\n\n/* ── page ── */\n.page {\n  flex: 1 1 auto;\n  display: flex; flex-direction: column;\n  padding: 24px 24px 0;\n}\n.rise { opacity: 0; transform: translateY(10px); animation: rise .42s cubic-bezier(.22,.61,.36,1) forwards; }\n@keyframes rise { to { opacity: 1; transform: none; } }\n\n/* identity header — compact, left aligned */\n.head { display: flex; align-items: center; gap: 16px; }\n.head .tile {\n  width: 76px; height: 76px; flex: none;\n  border-radius: 24px;\n  background: #E8F8EF;\n  border: 1.5px solid rgba(32,201,106,.30);\n  display: flex; align-items: center; justify-content: center;\n}\n.head .tile .msy { font-size: 38px; color: #0E9F55; font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 48; }\n.head .txt { min-width: 0; }\n.head .txt .nm { font-size: 26px; font-weight: 800; letter-spacing: -0.5px; line-height: 1.2; }\n.head .txt .sub { margin-top: 6px; font-size: 14px; font-weight: 500; color: #64748B; }\n\n/* credential region */\n.form { margin-top: 20px; }\n.grp + .grp { margin-top: 14px; }\n.grp label {\n  display: block; margin-bottom: 7px;\n  font-size: 13px; font-weight: 700; color: #64748B;\n}\n.field {\n  position: relative;\n  display: flex; align-items: center; gap: 4px;\n  height: 54px;\n  background: #FFFFFF;\n  border: 1.5px solid #F1F5F9;\n  border-radius: 16px;\n  box-shadow: 0 3px 10px rgba(30,41,59,.03);\n  transition: border-color .15s ease, box-shadow .15s ease;\n}\n.field:focus-within {\n  border-color: #20C96A;\n  box-shadow: 0 3px 10px rgba(30,41,59,.03), 0 0 0 3px rgba(32,201,106,.12);\n}\n.field .msy { font-size: 20px; color: #64748B; margin: 0 4px 0 14px; flex: none; }\n.field input {\n  flex: 1 1 auto; min-width: 0;\n  border: 0; outline: 0; background: transparent;\n  font-family: inherit; font-size: 14px; font-weight: 500; color: #1E293B;\n  letter-spacing: 0;\n}\n.field input.masked { letter-spacing: 2.5px; font-weight: 700; }\n.field input::placeholder { color: #64748B; font-weight: 400; }\n.field .toggle {\n  flex: none; width: 44px; height: 44px; margin-right: 4px;\n  display: flex; align-items: center; justify-content: center;\n  border: 0; background: transparent; cursor: pointer; border-radius: 12px;\n}\n.field .toggle .msy { font-size: 19px; color: #64748B; margin: 0; }\n.field .toggle:active { background: #F1F5F9; }\n\n.recover {\n  margin-top: 8px;\n  display: flex; justify-content: flex-end;\n}\n.recover button {\n  border: 0; background: transparent; cursor: pointer; font-family: inherit;\n  font-size: 13px; font-weight: 700; color: #0E9F55;\n  padding: 6px 2px;\n}\n.recover button:active { opacity: .6; }\n\n/* primary action */\n.submit {\n  margin-top: 20px;\n  width: 100%; height: 54px;\n  display: flex; align-items: center; justify-content: center; gap: 8px;\n  background: #20C96A; color: #FFFFFF;\n  border: 0; border-radius: 18px; cursor: pointer;\n  font-family: inherit; font-size: 15px; font-weight: 800; letter-spacing: -0.2px;\n  box-shadow: 0 6px 14px rgba(32,201,106,.28);\n  transition: transform .12s ease, box-shadow .12s ease;\n}\n.submit .msy { font-size: 20px; color: #FFFFFF; }\n.submit:active { transform: translateY(1px); box-shadow: 0 4px 10px rgba(32,201,106,.24); }\n.submit.is-busy { pointer-events: none; color: rgba(255,255,255,.72); box-shadow: none; background: #C7D2CE; }\n.submit.is-busy .msy { color: rgba(255,255,255,.72); }\n.spin {\n  width: 18px; height: 18px; flex: none;\n  border: 2px solid rgba(255,255,255,.45); border-top-color: #FFFFFF;\n  border-radius: 50%; animation: spin .7s linear infinite;\n}\n@keyframes spin { to { transform: rotate(360deg); } }\n\n/* secondary paths — pushed to the base so the primary action owns the fold */\n.secondary { margin-top: auto; padding-bottom: 14px; }\n.signup {\n  margin-top: 20px;\n  font-size: 13px; font-weight: 500; color: #64748B; text-align: center;\n}\n.signup button {\n  border: 0; background: transparent; cursor: pointer; font-family: inherit;\n  font-size: 13px; font-weight: 800; color: #0E9F55; padding: 0 0 0 2px;\n}\n.signup button:active { opacity: .6; }\n.admin {\n  margin-top: 16px;\n  display: flex; align-items: center; justify-content: center; gap: 7px;\n  border: 0; background: transparent; cursor: pointer; font-family: inherit;\n  width: 100%; padding: 10px 0 0;\n  font-size: 13px; font-weight: 700; color: #0E9F55;\n}\n.admin .msy { font-size: 18px; color: #0E9F55; }\n.admin:active { opacity: .6; }\n\n.homebar { flex: none; height: 24px; display: flex; align-items: center; justify-content: center; }\n.homebar span { width: 100px; height: 5px; border-radius: 5px; background: #1E293B; opacity: .85; }\n</style>\n<div class=\"statusbar\" data-kid=\"1\" data-name=\"status bar\">\n<div class=\"t\" data-kid=\"1-1\" data-name=\"status bar time display\">9:41</div>\n<div aria-hidden=\"true\" class=\"sys\" data-kid=\"1-2\" data-name=\"status system icons container\"><span class=\"msy\" data-kid=\"1-2-1\" data-name=\"cellular signal icon\">signal_cellular_alt</span><span class=\"msy\" data-kid=\"1-2-2\" data-name=\"wifi icon\">wifi</span><span class=\"msy\" data-kid=\"1-2-3\" data-name=\"battery icon\">battery_full</span></div>\n</div>\n<header class=\"appbar\" data-kid=\"2\" data-name=\"app top bar\"><h1 data-kid=\"2-1\" data-name=\"app title heading\">ยินดีต้อนรับกลับ</h1></header>\n<main class=\"page\" data-kid=\"3\" data-name=\"main page content\">\n<section class=\"head rise\" data-kid=\"3-1\" data-name=\"identity header with avatar\" style=\"animation-delay:.02s\">\n<div class=\"tile\" data-kid=\"3-1-1\" data-name=\"green avatar tile\"><span class=\"msy\" data-kid=\"3-1-1-1\" data-name=\"restaurant avatar icon\">restaurant</span></div>\n<div class=\"txt\" data-kid=\"3-1-2\" data-name=\"identity text block\">\n<div class=\"nm\" data-kid=\"3-1-2-1\" data-name=\"profile name text\">วิเคราะห์โภชนาการ</div>\n<div class=\"sub\" data-kid=\"3-1-2-2\" data-name=\"profile subtitle text\">สแกนอาหาร คำนวณแคลอรี่</div>\n</div>\n</section>\n<form autocomplete=\"off\" class=\"form rise\" data-kid=\"3-2\" data-name=\"sign-in form\" id=\"signin\" novalidate=\"\" style=\"animation-delay:.1s\">\n<div class=\"grp\" data-kid=\"3-2-1\" data-name=\"email field group\">\n<label data-kid=\"3-2-1-1\" data-name=\"email field label\" for=\"email\">อีเมล</label>\n<div class=\"field\" data-kid=\"3-2-1-2\" data-name=\"email input field wrapper\">\n<span class=\"msy\" data-kid=\"3-2-1-2-1\" data-name=\"mail icon\">mail</span>\n<input data-kid=\"3-2-1-2-2\" data-name=\"email input field\" id=\"email\" inputmode=\"email\" name=\"email\" placeholder=\"name@example.com\" type=\"email\" value=\"user2@gmail.com\"/>\n</div>\n</div>\n<div class=\"grp\" data-kid=\"3-2-2\" data-name=\"password field group\">\n<label data-kid=\"3-2-2-1\" data-name=\"password field label\" for=\"pass\">รหัสผ่าน</label>\n<div class=\"field\" data-kid=\"3-2-2-2\" data-name=\"password input field wrapper\">\n<span class=\"msy\" data-kid=\"3-2-2-2-1\" data-name=\"lock icon\">lock</span>\n<input class=\"masked\" data-dynamic=\"true\" data-kid=\"3-2-2-2-2\" data-name=\"password input field\" data-reason=\"value replaced with bullet characters by masking script on load and toggle\" id=\"pass\" name=\"password\" placeholder=\" \" type=\"password\" value=\"Doraemon2540\"/>\n<button aria-label=\"แสดงรหัสผ่าน\" class=\"toggle\" data-kid=\"3-2-2-2-3\" data-name=\"show/hide password button\" id=\"reveal\" type=\"button\"><span class=\"msy\" data-dynamic=\"true\" data-kid=\"3-2-2-2-3-1\" data-name=\"eye visibility icon\" data-reason=\"icon text swapped by script on reveal toggle\" id=\"revealIcon\">visibility_off</span></button>\n</div>\n<div class=\"recover\" data-kid=\"3-2-2-3\" data-name=\"credential recovery link row\"><button data-kid=\"3-2-2-3-1\" data-name=\"forgot password link button\" id=\"forgot\" type=\"button\">ลืมรหัสผ่าน?</button></div>\n</div>\n<button class=\"submit rise\" data-kid=\"3-2-3\" data-name=\"primary submit button\" id=\"submit\" style=\"animation-delay:.18s\" type=\"submit\">\n<span class=\"msy\" data-dynamic=\"true\" data-kid=\"3-2-3-1\" data-name=\"login button icon\" data-reason=\"replaced by spinner and re-typed on form submit\" id=\"submitIcon\">login</span><span data-dynamic=\"true\" data-kid=\"3-2-3-2\" data-name=\"submit button label text\" data-reason=\"text replaced by busy state text on submit\" id=\"submitText\">เข้าสู่ระบบ</span>\n</button>\n</form>\n<div class=\"secondary rise\" data-kid=\"3-3\" data-name=\"secondary action paths\" style=\"animation-delay:.26s\">\n<p class=\"signup\" data-kid=\"3-3-1\" data-name=\"signup prompt line\">ยังไม่มีบัญชีใช่ไหม?<button data-kid=\"3-3-1-1\" data-name=\"register new member link\" id=\"register\" type=\"button\">สมัครสมาชิกใหม่</button></p>\n<button class=\"admin\" data-kid=\"3-3-2\" data-name=\"admin login link button\" id=\"admin\" type=\"button\"><span class=\"msy\" data-kid=\"3-3-2-1\" data-name=\"admin panel icon\">admin_panel_settings</span>เข้าสู่ระบบสำหรับผู้ดูแลระบบ</button>\n</div>\n</main>\n<div class=\"homebar\" data-kid=\"4\" data-name=\"home indicator bar container\"><span data-kid=\"4-1\" data-name=\"home indicator bar\"></span></div>\n<script>\n(function () {\n  var pass = document.getElementById('pass');\n  var revealBtn = document.getElementById('reveal');\n  var revealIcon = document.getElementById('revealIcon');\n  var real = pass.value;\n  var shown = false;\n\n  function paint() {\n    pass.classList.toggle('masked', !shown);\n    pass.value = shown ? real : real.replace(/[^\\s]/g, '\\u2022');\n    revealIcon.textContent = shown ? 'visibility' : 'visibility_off';\n    revealBtn.setAttribute('aria-label', shown ? 'ซ่อนรหัสผ่าน' : 'แสดงรหัสผ่าน');\n  }\n  paint();\n\n  pass.addEventListener('focus', function () {\n    if (!shown && pass.value !== real.replace(/[^\\s]/g, '\\u2022')) { pass.value = ''; }\n  });\n  pass.addEventListener('input', function () {\n    if (shown) { real = pass.value; } else { real = real.slice(0, pass.value.length); }\n    if (!shown) paint();\n  });\n  revealBtn.addEventListener('click', function () { shown = !shown; paint(); });\n\n  var form = document.getElementById('signin');\n  var submit = document.getElementById('submit');\n  var submitText = document.getElementById('submitText');\n  var submitIcon = document.getElementById('submitIcon');\n  var busy = false;\n\n  form.addEventListener('submit', function (e) {\n    e.preventDefault();\n    if (busy) return;\n    busy = true;\n    submit.classList.add('is-busy');\n    submitIcon.outerHTML = '<span class=\"spin\"></span>';\n    submitText.textContent = 'กำลังเข้าสู่ระบบ';\n    setTimeout(function () {\n      submit.classList.remove('is-busy');\n      var host = submit;\n      var old = host.querySelector('.spin');\n      if (old) {\n        var ic = document.createElement('span');\n        ic.className = 'msy'; ic.id = 'submitIcon'; ic.textContent = 'login';\n        host.replaceChild(ic, old);\n      }\n      submitText.textContent = 'เข้าสู่ระบบ';\n      busy = false;\n    }, 1800);\n  });\n})();\n</script>",
