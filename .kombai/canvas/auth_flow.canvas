      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,300..700,0..1,0&display=block');\n@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400..800&display=block');\n\n* { box-sizing: border-box; margin: 0; padding: 0; }\nhtml, body { height: 100%; }\nbody {\n  font-family: \"Noto Sans Thai\", \"Segoe UI\", Roboto, sans-serif;\n  background: #FFFFFF;\n  color: #1E293B;\n  -webkit-font-smoothing: antialiased;\n}\n\n.appbar {\n  height: 60px;\n  background: #FFFFFF;\n  border-bottom: 1px solid #F1F5F9;\n  display: flex;\n  align-items: center;\n  padding: 0 24px;\n  position: relative;\n}\n.appbar-back {\n  width: 40px;\n  height: 40px;\n  border-radius: 14px;\n  border: 1.5px solid #F1F5F9;\n  background: #FFFFFF;\n  box-shadow: 0 2px 8px rgba(30, 41, 59, 0.04);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: #1E293B;\n  font-size: 15px;\n  cursor: pointer;\n}\n.appbar-title {\n  position: absolute;\n  left: 0; right: 0;\n  text-align: center;\n  font-size: 18px;\n  font-weight: 800;\n  letter-spacing: -0.3px;\n  color: #1E293B;\n  pointer-events: none;\n  line-height: 60px;\n}\n\n.statusbar {\n  height: 44px;\n  padding: 0 24px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  background: #FFFFFF;\n}\n.statusbar .time { font-size: 15px; font-weight: 700; color: #1E293B; }\n.statusbar .sys { display: flex; align-items: center; gap: 4px; color: #1E293B; }\n.statusbar .sys .msr { font-size: 17px; }\n.msr {\n  font-family: \"Material Symbols Rounded\";\n  font-weight: normal;\n  font-style: normal;\n  line-height: 1;\n  letter-spacing: normal;\n  text-transform: none;\n  display: inline-block;\n  white-space: nowrap;\n  direction: ltr;\n  font-variation-settings: \"FILL\" 0, \"wght\" 400, \"GRAD\" 0, \"opsz\" 24;\n  -webkit-font-feature-settings: \"liga\";\n  -webkit-font-smoothing: antialiased;\n}\n.page { padding: 24px; min-height: 712px; display: flex; flex-direction: column; }\n\n/* ── Step header (OnboardingStepHeader) ── */\n.step-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: baseline;\n}\n.step-count { font-size: 12px; font-weight: 700; color: #64748B; }\n.step-name { font-size: 13px; font-weight: 800; color: #0E9F55; }\n.step-track {\n  margin-top: 8px;\n  height: 4px;\n  border-radius: 2px;\n  background: #F1F5F9;\n  overflow: hidden;\n}\n.step-fill {\n  height: 100%;\n  width: 25%;\n  background: #20C96A;\n  border-radius: 2px;\n}\n\n/* ── Heading ── */\n.head-block { margin-top: 20px; }\n.head-title { font-size: 22px; font-weight: 800; color: #1E293B; letter-spacing: -0.3px; }\n.head-sub { margin-top: 6px; font-size: 13px; color: #64748B; }\n\n/* ── Fields ── */\n.fields { margin-top: 24px; }\n.field-group + .field-group { margin-top: 14px; }\n.field-label {\n  font-size: 13px;\n  font-weight: 700;\n  color: #64748B;\n  margin-bottom: 6px;\n}\n.field-box {\n  height: 54px;\n  background: #FFFFFF;\n  border: 1.5px solid #F1F5F9;\n  border-radius: 16px;\n  box-shadow: 0 3px 10px rgba(30, 41, 59, 0.03);\n  display: flex;\n  align-items: center;\n  padding: 0 6px 0 16px;\n  transition: border-color 120ms ease, box-shadow 120ms ease;\n}\n.field-box:focus-within {\n  border-color: rgba(32, 201, 106, 0.55);\n  box-shadow: 0 3px 12px rgba(32, 201, 106, 0.10);\n}\n.field-icon { font-size: 18px; color: #64748B; width: 24px; flex: none; text-align: center; }\n.field-box input {\n  flex: 1;\n  min-width: 0;\n  border: none;\n  outline: none;\n  background: transparent;\n  font-family: inherit;\n  font-size: 14px;\n  font-weight: 500;\n  color: #1E293B;\n  padding: 0 10px;\n}\n.field-box input::placeholder { color: #64748B; font-weight: 400; }\n.eye-btn {\n  flex: none;\n  width: 40px;\n  height: 40px;\n  border: none;\n  background: transparent;\n  border-radius: 12px;\n  color: #64748B;\n  font-size: 18px;\n  font-family: \"Material Symbols Rounded\";\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  cursor: pointer;\n}\n.eye-btn:active { background: #F1F5F9; }\ninput.pw-masked { letter-spacing: 2px; }\n\n/* ── Requirement line ── */\n.req-line {\n  margin-top: 20px;\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 12px;\n  color: #64748B;\n}\n.req-line .msr { font-size: 14px; color: #20C96A; font-variation-settings: \"FILL\" 1, \"wght\" 400, \"GRAD\" 0, \"opsz\" 24; }\n\n/* ── Primary button (PrimaryButton) ── */\n.btn-primary {\n  margin-top: 20px;\n  width: 100%;\n  height: 54px;\n  border: none;\n  border-radius: 18px;\n  background: #20C96A;\n  color: #FFFFFF;\n  font-family: inherit;\n  font-size: 15px;\n  font-weight: 800;\n  letter-spacing: -0.2px;\n  box-shadow: 0 6px 14px rgba(32, 201, 106, 0.28);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  cursor: pointer;\n  transition: background 120ms ease, transform 80ms ease;\n}\n.btn-primary .msr { font-size: 18px; color: #FFFFFF; }\n.btn-primary:active { background: #0E9F55; transform: translateY(1px); }\n\n/* ── Sign-in link ── */\n.signin-row {\n  margin-top: 16px;\n  text-align: center;\n  font-size: 13px;\n  color: #64748B;\n}\n.signin-row a {\n  color: #0E9F55;\n  font-weight: 800;\n  text-decoration: none;\n  margin-left: 4px;\n}\n.footnote {\n  margin-top: auto;\n  padding-top: 24px;\n  font-size: 12px;\n  line-height: 1.45;\n  color: #64748B;\n}\n.home-indicator {\n  flex: none;\n  height: 24px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n.home-indicator span { width: 100px; height: 5px; border-radius: 3px; background: #1E293B; }\n</style>\n<div class=\"statusbar\" data-kid=\"3\" data-name=\"phone status bar\">\n<span class=\"time\" data-kid=\"3-1\">9:41</span>\n<span class=\"sys\" data-kid=\"3-2\"><span class=\"msr\" data-kid=\"3-2-1\">signal_cellular_alt</span><span class=\"msr\" data-kid=\"3-2-2\">wifi</span><span class=\"msr\" data-kid=\"3-2-3\">battery_full</span></span>\n</div>\n<div class=\"appbar\" data-kid=\"1\" data-name=\"top app bar\">\n<div class=\"appbar-back\" data-kid=\"1-1\" data-name=\"back navigation button\"><span class=\"msr\" data-kid=\"1-1-1\" data-name=\"left chevron back icon\" style=\"font-size:20px;\">chevron_left</span></div>\n<div class=\"appbar-title\" data-kid=\"1-2\" data-name=\"app bar title text\">สมัครสมาชิก</div>\n</div>\n<div class=\"page\" data-kid=\"2\" data-name=\"onboarding page container\">\n<div class=\"step-row\" data-kid=\"2-1\" data-name=\"step progress header row\">\n<span class=\"step-count\" data-kid=\"2-1-1\" data-name=\"step counter label\">ขั้นตอนที่ 1/4</span>\n<span class=\"step-name\" data-kid=\"2-1-2\" data-name=\"step name label\">สร้างบัญชีผู้ใช้</span>\n</div>\n<div class=\"step-track\" data-kid=\"2-2\" data-name=\"step progress track\"><div class=\"step-fill\" data-kid=\"2-2-1\" data-name=\"step progress fill bar\"></div></div>\n<div class=\"head-block\" data-kid=\"2-3\" data-name=\"section heading block\">\n<div class=\"head-title\" data-kid=\"2-3-1\" data-name=\"page heading title\">เริ่มต้นดูแลโภชนาการของคุณ</div>\n<div class=\"head-sub\" data-kid=\"2-3-2\" data-name=\"page subtitle text\">กรอกข้อมูลพื้นฐานเพื่อสร้างบัญชีผู้ใช้งาน</div>\n</div>\n<div class=\"fields\" data-kid=\"2-4\" data-name=\"form fields container\">\n<div class=\"field-group\" data-kid=\"2-4-1\" data-name=\"name field group\">\n<div class=\"field-label\" data-kid=\"2-4-1-1\" data-name=\"name field label\">ชื่อ - นามสกุล</div>\n<div class=\"field-box\" data-kid=\"2-4-1-2\" data-name=\"name input field box\">\n<span class=\"msr field-icon\" data-kid=\"2-4-1-2-1\" data-name=\"person icon\">person</span>\n<input autocomplete=\"name\" data-kid=\"2-4-1-2-2\" data-name=\"full name text input\" placeholder=\"สมชาย ใจดี\" type=\"text\"/>\n</div>\n</div>\n<div class=\"field-group\" data-kid=\"2-4-2\" data-name=\"email field group\">\n<div class=\"field-label\" data-kid=\"2-4-2-1\" data-name=\"email field label\">อีเมล</div>\n<div class=\"field-box\" data-kid=\"2-4-2-2\" data-name=\"email input field box\">\n<span class=\"msr field-icon\" data-kid=\"2-4-2-2-1\" data-name=\"envelope icon\">mail</span>\n<input autocomplete=\"email\" data-kid=\"2-4-2-2-2\" data-name=\"email address input\" placeholder=\"name@example.com\" type=\"email\"/>\n</div>\n</div>\n<div class=\"field-group\" data-kid=\"2-4-3\" data-name=\"password field group\">\n<div class=\"field-label\" data-kid=\"2-4-3-1\" data-name=\"password field label\">รหัสผ่าน</div>\n<div class=\"field-box\" data-kid=\"2-4-3-2\" data-name=\"password input field box\">\n<span class=\"msr field-icon\" data-kid=\"2-4-3-2-1\" data-name=\"lock icon\">lock</span>\n<input autocomplete=\"new-password\" class=\"pw-masked\" data-kid=\"2-4-3-2-2\" data-name=\"password text input\" id=\"pw\" type=\"password\" value=\"Nutri2540\"/>\n<button aria-label=\"แสดงรหัสผ่าน\" class=\"eye-btn\" data-dynamic=\"true\" data-kid=\"2-4-3-2-3\" data-name=\"show/hide password toggle button\" data-reason=\"icon and aria-label swapped by eye button click script\" id=\"eye\" type=\"button\"><span class=\"msr\" data-dynamic=\"true\" data-kid=\"2-4-3-2-3-1\" data-name=\"eye icon indicating password hidden\" data-reason=\"icon name replaced by eye toggle script on click\">visibility_off</span></button>\n</div>\n</div>\n</div>\n<div class=\"req-line\" data-kid=\"2-5\" data-name=\"password requirement line\">\n<span class=\"msr\" data-kid=\"2-5-1\" data-name=\"green check circle icon\">check_circle</span>\n<span data-kid=\"2-5-2\" data-name=\"password requirement hint text\">รหัสผ่านต้องมีอย่างน้อย 8 ตัวอักษร</span>\n</div>\n<button class=\"btn-primary\" data-kid=\"2-6\" data-name=\"create account primary button\" type=\"button\">\n<span class=\"msr\" data-kid=\"2-6-1\" data-name=\"add person icon\">person_add</span>\n<span data-kid=\"2-6-2\" data-name=\"button label text\">สร้างบัญชี</span>\n</button>\n<div class=\"signin-row\" data-kid=\"2-7\" data-name=\"sign-in prompt row\">\n<span data-kid=\"2-7-1\" data-name=\"sign-in prompt text\">มีบัญชีอยู่แล้ว?</span><a data-kid=\"2-7-2\" data-name=\"sign-in link\" href=\"#\">เข้าสู่ระบบ</a>\n</div>\n<p class=\"footnote\" data-kid=\"2-8\">ขั้นตอนถัดไปคือการกำหนดข้อมูลสุขภาพและเป้าหมายแคลอรี่ประจำวัน</p>\n</div>\n<div class=\"home-indicator\" data-kid=\"6\" data-name=\"home indicator\"><span data-kid=\"6-1\"></span></div>\n<script>\n  const pw = document.getElementById('pw');\n  const eye = document.getElementById('eye');\n  eye.addEventListener('click', () => {\n    const showing = pw.type === 'text';\n    pw.type = showing ? 'password' : 'text';\n    eye.innerHTML = showing ? '<i class=\"bi bi-eye-slash\"></i>' : '<i class=\"bi bi-eye\"></i>';\n    eye.setAttribute('aria-label', showing ? 'แสดงรหัสผ่าน' : 'ซ่อนรหัสผ่าน');\n  });\n</script>",
