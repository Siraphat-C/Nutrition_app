      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,300..700,0..1,0&display=block');\n  @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400..800&display=block');\n  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }\n  html, body { margin: 0; padding: 0; }\n  body {\n    width: 375px; height: 812px;\n    display: flex; flex-direction: column;\n    background: #FFFFFF;\n    color: #1E293B;\n    font-family: 'Noto Sans Thai', 'Segoe UI', Roboto, sans-serif;\n  }\n  .msr { font-family: \"Material Symbols Rounded\"; font-weight: 400; font-style: normal; line-height: 1; letter-spacing: normal; text-transform: none; white-space: nowrap; direction: ltr; font-feature-settings: \"liga\"; -webkit-font-smoothing: antialiased; }\n\n  .statusbar { height: 44px; flex: none; display: flex; align-items: center; justify-content: space-between; padding: 0 24px; }\n  .statusbar .t { font-size: 15px; font-weight: 700; color: #1E293B; letter-spacing: -.2px; }\n  .statusbar .sys { display: flex; align-items: center; gap: 5px; color: #1E293B; }\n  .statusbar .sys .msr { font-size: 17px; }\n  .appbar { height: 60px; flex: none; display: flex; align-items: center; gap: 12px; padding: 0 20px 0 24px; background: #FFFFFF; }\n  .back { width: 40px; height: 40px; flex: 0 0 40px; display: flex; align-items: center; justify-content: center; border: 1.5px solid #F1F5F9; border-radius: 14px; background: #FFFFFF; box-shadow: 0 2px 8px rgba(30,41,59,.04); }\n  .back .msr { font-size: 20px; color: #1E293B; }\n  .appbar h1 { margin: 0; font-size: 18px; font-weight: 800; letter-spacing: -0.1px; color: #1E293B; }\n  .rule { height: 1px; background: #F1F5F9; }\n\n  .content { padding: 24px; flex: 1 1 auto; }\n  .foot { flex: none; display: flex; flex-direction: column; align-items: center; gap: 10px; padding-bottom: 12px; }\n  .foot .note { font-size: 12px; font-weight: 500; color: #64748B; }\n  .foot .home { width: 100px; height: 5px; border-radius: 5px; background: #1E293B; }\n\n  .identity { height: 88px; display: flex; align-items: center; gap: 14px; }\n  .avatar { width: 56px; height: 56px; flex: 0 0 56px; border-radius: 50%; background: #E8F8EF; border: 1.5px solid rgba(32,201,106,0.30); display: flex; align-items: center; justify-content: center; }\n  .who { flex: 1 1 auto; min-width: 0; }\n  .who .nm { font-size: 17px; font-weight: 800; color: #1E293B; line-height: 1.25; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n  .who .em { margin-top: 3px; font-size: 13px; font-weight: 500; color: #64748B; line-height: 1.25; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n  .edit { flex: 0 0 auto; min-width: 44px; height: 44px; display: flex; align-items: center; justify-content: flex-end; font-size: 13px; font-weight: 800; color: #0E9F55; }\n\n  .rows { margin-top: 20px; }\n  .row { height: 64px; display: flex; align-items: center; gap: 14px; padding: 0 10px; margin: 0 -10px; width: calc(100% + 20px); border-radius: 14px; background: #FFFFFF; }\n  .tile { width: 40px; height: 40px; flex: 0 0 40px; border-radius: 12px; background: #E8F8EF; display: flex; align-items: center; justify-content: center; }\n  .tile .msr { font-size: 20px; color: #20C96A; }\n  .row .lb { flex: 1 1 auto; font-size: 15px; font-weight: 700; color: #1E293B; }\n  .row .msr.chev { font-size: 18px; color: #64748B; }\n  .hair { height: 1px; background: #F1F5F9; }\n\n  .row.pressed { background: #E8F8EF; box-shadow: inset 0 0 0 1.5px rgba(32,201,106,0.30); }\n  .row.pressed .tile { background: #FFFFFF; border: 1.5px solid rgba(32,201,106,0.30); }\n\n  .out { margin-top: 24px; }\n  .out .tile { background: #FFF1F0; }\n  .out .tile .msr { color: #FF4D4F; }\n  .out .lb { color: #FF4D4F; }\n  .out .msr.chev { color: rgba(255,77,79,0.55); }\n</style>\n<div class=\"statusbar\" data-kid=\"1\" data-name=\"phone status bar\">\n<span class=\"t\" data-kid=\"1-1\" data-name=\"status bar clock time\">9:41</span>\n<span class=\"sys\" data-kid=\"1-2\" data-name=\"status bar system icons\"><span class=\"msr\" data-kid=\"1-2-1\" data-name=\"cellular signal icon\">signal_cellular_alt</span><span class=\"msr\" data-kid=\"1-2-2\" data-name=\"wifi icon\">wifi</span><span class=\"msr\" data-kid=\"1-2-3\" data-name=\"battery icon\">battery_full</span></span>\n</div>\n<div class=\"appbar\" data-kid=\"2\" data-name=\"app bar header\">\n<div class=\"back\" data-kid=\"2-1\" data-name=\"back button\"><span class=\"msr\" data-kid=\"2-1-1\" data-name=\"left chevron back icon\">chevron_left</span></div>\n<h1 data-kid=\"2-2\" data-name=\"page title\">ตั้งค่า</h1>\n</div>\n<div class=\"rule\" data-kid=\"3\" data-name=\"header divider rule\"></div>\n<div class=\"content\" data-kid=\"4\" data-name=\"main content area\">\n<div class=\"identity\" data-kid=\"3-1\" data-name=\"user identity section\">\n<div class=\"avatar\" data-kid=\"3-1-1\" data-name=\"user avatar container\"><span class=\"msr\" data-dynamic=\"true\" data-kid=\"3-1-1-1\" data-name=\"person avatar icon\" data-reason=\"icon ligature text replaced by tone-mark remapping script on load\" style=\"font-size:26px;font-weight:500;color:#20C96A;\">person</span></div>\n<div class=\"who\" data-kid=\"3-1-2\" data-name=\"user identity info group\">\n<div class=\"nm\" data-kid=\"3-1-2-1\" data-name=\"display name text\">ปิติโชค โดราเอม่อน</div>\n<div class=\"em\" data-kid=\"3-1-2-2\" data-name=\"email address text\">user2@gmail.com</div>\n</div>\n<div class=\"edit\" data-dynamic=\"true\" data-kid=\"3-1-3\" data-name=\"edit identity link\" data-reason=\"text replaced by Thai tone-mark remapping script on load\">แก้ไข</div>\n</div>\n<div class=\"rule\" data-kid=\"3-2\" data-name=\"divider rule\"></div>\n<div class=\"rows\" data-kid=\"3-3\" data-name=\"settings menu group\">\n<div class=\"row\" data-kid=\"3-3-1\" data-name=\"edit account details row\">\n<div class=\"tile\" data-kid=\"3-3-1-1\" data-name=\"icon tile container\"><span class=\"msr\" data-dynamic=\"true\" data-kid=\"3-3-1-1-1\" data-name=\"person edit icon\" data-reason=\"icon ligature text replaced by tone-mark remapping script on load\">person_edit</span></div>\n<div class=\"lb\" data-dynamic=\"true\" data-kid=\"3-3-1-2\" data-name=\"edit account details label\" data-reason=\"text replaced by Thai tone-mark remapping script on load\">แก้ไขข้อมูลบัญชี</div>\n<span class=\"msr chev\" data-dynamic=\"true\" data-kid=\"3-3-1-3\" data-name=\"right chevron icon\" data-reason=\"icon ligature text replaced by tone-mark remapping script on load\">chevron_right</span>\n</div>\n<div class=\"hair\" data-kid=\"3-3-2\" data-name=\"row divider line\"></div>\n<div class=\"row pressed\" data-kid=\"3-3-3\" data-name=\"change password row pressed state\">\n<div class=\"tile\" data-kid=\"3-3-3-1\" data-name=\"icon tile container\"><span class=\"msr\" data-dynamic=\"true\" data-kid=\"3-3-3-1-1\" data-name=\"lock reset icon\" data-reason=\"icon ligature text replaced by tone-mark remapping script on load\">lock_reset</span></div>\n<div class=\"lb\" data-dynamic=\"true\" data-kid=\"3-3-3-2\" data-name=\"change password label\" data-reason=\"text replaced by Thai tone-mark remapping script on load\">เปลี่ยนรหัสผ่าน</div>\n<span class=\"msr chev\" data-dynamic=\"true\" data-kid=\"3-3-3-3\" data-name=\"right chevron icon\" data-reason=\"icon ligature text replaced by tone-mark remapping script on load\">chevron_right</span>\n</div>\n</div>\n<div class=\"row out\" data-kid=\"3-4\" data-name=\"logout row\">\n<div class=\"tile\" data-kid=\"3-4-1\" data-name=\"logout icon tile\"><span class=\"msr\" data-dynamic=\"true\" data-kid=\"3-4-1-1\" data-name=\"logout icon\" data-reason=\"icon ligature text replaced by tone-mark remapping script on load\">logout</span></div>\n<div class=\"lb\" data-dynamic=\"true\" data-kid=\"3-4-2\" data-name=\"logout label\" data-reason=\"text replaced by Thai tone-mark remapping script on load\">ออกจากระบบ</div>\n<span class=\"msr chev\" data-dynamic=\"true\" data-kid=\"3-4-3\" data-name=\"right chevron icon\" data-reason=\"icon ligature text replaced by tone-mark remapping script on load\">chevron_right</span>\n</div>\n</div>\n<div class=\"foot\" data-kid=\"5\" data-name=\"bottom footnote and home indicator\">\n<span class=\"note\" data-kid=\"5-1\" data-name=\"signed-in account footnote\">เข้าสู่ระบบเป็น user2@gmail.com</span>\n<span class=\"home\" data-kid=\"5-2\" data-name=\"home indicator bar\"></span>\n</div>\n",
